{
  "name": "manga-atlas",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Mangá Atlas — Blog estático de reviews, artigos, recomendações, biblioteca de obras e colecionismo em Astro.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:demo": "node scripts/run-demo.mjs dev",
    "content:validate": "node scripts/validate-content.mjs",
    "content:new": "node scripts/new-content.mjs",
    "build": "npm run content:validate && astro build && node scripts/check-isolation.mjs && npx pagefind --site dist",
    "build:demo": "node scripts/run-demo.mjs build",
    "preview": "astro preview",
    "preview:demo": "node scripts/run-demo.mjs preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@lucide/astro": "^1.78.0",
    "astro": "^7.4.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
