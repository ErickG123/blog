---
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = 'Notícias, análises, guias e descobertas de anime e mangá.',
  image,
  type = 'website',
} = Astro.props;

const isNotFound = /\/404\/?$/.test(Astro.url.pathname);
const canonicalURL = !isNotFound && Astro.site ? new URL(Astro.url.pathname, Astro.site) : !isNotFound ? Astro.url : undefined;
const imageURL = image && Astro.site ? new URL(image, Astro.site) : image;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const base = (path: string) => baseUrl + path.replace(/^\/+/, '');
const basePathname = baseUrl.replace(/\/+$/, '');
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const routePath = pathname.startsWith(basePathname) ? pathname.slice(basePathname.length) || '/' : pathname;
const isActive = (path: string) => routePath === path.replace(/\/+$/, '') || (path !== '/' && routePath.startsWith(`${path.replace(/\/+$/, '')}/`));
const isMoreActive = ['/reviews/', '/guias/', '/temporadas/'].some(isActive);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f5f2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isNotFound && <meta name="robots" content="noindex, nofollow" />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href={base('/rss.xml')} />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
      } catch {
        /* Storage may be disabled; keep the default theme. */
      }
    </script>
    <style is:global>
      :root {
        color-scheme: light;
        --paper: #f5f5f2;
        --surface: #ffffff;
        --surface-raised: #ffffff;
        --surface-soft: #eaecef;
        --ink: #1e2329;
        --muted: #4f5862;
        --line: #848c94;
        --line-subtle: #d6dadf;
        --accent: #ad392f;
        --accent-hover: #8d2c24;
        --accent-soft: #f7e6e4;
        --accent-contrast: #ffffff;
        --blue: #2d557a;
        --code-bg: #1e2227;
        --focus: #1f5687;
        --shadow-sm: 0 2px 6px rgb(20 26 32 / 6%);
        --shadow: 0 10px 26px rgb(20 26 32 / 10%);
        --font-body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --font-display: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Consolas, monospace;
        --space-1: .25rem;
        --space-2: .5rem;
        --space-3: .75rem;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-7: 2.5rem;
        --space-8: 3.25rem;
        --container: 1200px;
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 14px;
        /* Semantic aliases preserved for audit scripts and token checks */
        --bg: var(--paper);
        --text: var(--ink);
        --border: var(--line);
        --card-bg: var(--surface);
        --radius: var(--radius-md);
      }
      html.dark {
        color-scheme: dark;
        --paper: #0f141a;
        --surface: #171f28;
        --surface-raised: #1e2833;
        --surface-soft: #232f3c;
        --ink: #f1f4f7;
        --muted: #b3bec9;
        --line: #687582;
        --line-subtle: #2a3746;
        --accent: #ff9488;
        --accent-hover: #ffb0a7;
        --accent-soft: #3a2321;
        --accent-contrast: #22100e;
        --blue: #a4c6e6;
        --code-bg: #0b0e12;
        --focus: #8fc9ff;
        --shadow-sm: 0 2px 8px rgb(0 0 0 / 28%);
        --shadow: 0 12px 30px rgb(0 0 0 / 38%);
        --bg: var(--paper);
        --text: var(--ink);
        --border: var(--line);
        --card-bg: var(--surface);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 2rem; background: var(--paper); }
      body {
        width: min(100% - 2.5rem, var(--container));
        margin: 0 auto;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      a { color: var(--accent); text-decoration-thickness: .08em; text-underline-offset: .2em; }
      a:hover { color: var(--accent-hover); }
      button, input, select, textarea { font: inherit; }
      button, summary { cursor: pointer; }
      :focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
      ::selection { color: var(--accent-contrast); background: var(--accent); }
      h1, h2, h3, h4 { color: var(--ink); font-family: var(--font-display); line-height: 1.2; text-wrap: balance; }
      h1 { letter-spacing: -.03em; }
      img, svg { max-width: 100%; }
      img { display: block; }
      main { flex: 1 0 auto; width: 100%; }
      .skip-link {
        position: fixed; z-index: 1000; top: .5rem; left: .5rem;
        padding: .7rem 1rem; transform: translateY(-160%);
        border: 2px solid var(--ink); border-radius: var(--radius-sm);
        background: var(--surface); color: var(--ink); font-weight: 700;
      }
      .skip-link:focus { transform: translateY(0); }

      /* Compact Horizontal Site Header */
      .site-header {
        position: relative;
        z-index: 20;
        margin: 0 0 1.75rem;
        padding: .65rem 0;
        border-bottom: 1px solid var(--line-subtle);
      }
      .header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem 1.25rem;
        flex-wrap: wrap;
      }
      .site-brand {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        flex: 0 0 auto;
        color: var(--ink);
        font-size: 1.12rem;
        font-weight: 800;
        letter-spacing: -.03em;
        text-decoration: none;
      }
      .site-brand:hover { color: var(--accent); }
      .brand-mark {
        display: inline-grid;
        place-items: center;
        width: 1.65rem;
        height: 1.65rem;
        border-radius: var(--radius-sm);
        background: var(--accent);
        color: var(--accent-contrast);
        font-size: .78rem;
        font-weight: 900;
        letter-spacing: 0;
      }
      .primary-nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .25rem;
        flex: 1 1 auto;
      }
      .primary-nav > a,
      .more-nav > summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 2.3rem;
        padding: 0 .75rem;
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        color: var(--muted);
        font-size: .85rem;
        font-weight: 650;
        line-height: 1;
        text-align: center;
        text-decoration: none;
        white-space: nowrap;
        transition: background-color .15s ease, color .15s ease, border-color .15s ease;
      }
      .primary-nav > a:hover,
      .more-nav > summary:hover {
        background: var(--surface-soft);
        color: var(--ink);
      }
      .primary-nav > a[aria-current="page"],
      .more-nav[data-active="true"] > summary {
        background: var(--surface-soft);
        border-color: var(--line-subtle);
        color: var(--ink);
      }
      .more-nav { position: relative; }
      .more-nav > summary { list-style: none; cursor: pointer; }
      .more-nav > summary::-webkit-details-marker { display: none; }
      .more-nav > summary::after {
        width: .38rem;
        height: .38rem;
        margin: -.12rem 0 0 .42rem;
        transform: rotate(45deg);
        border-right: 1.6px solid currentColor;
        border-bottom: 1.6px solid currentColor;
        content: "";
      }
      .more-nav[open] > summary::after { margin-top: .18rem; transform: rotate(225deg); }
      .more-nav-list {
        position: absolute;
        top: calc(100% + .35rem);
        left: 0;
        z-index: 30;
        display: grid;
        min-width: 11.5rem;
        padding: .4rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        background: var(--surface);
        box-shadow: var(--shadow);
      }
      .more-nav-list a {
        display: flex;
        align-items: center;
        min-height: 2.15rem;
        padding: .45rem .65rem;
        border-radius: var(--radius-sm);
        color: var(--ink);
        font-size: .85rem;
        font-weight: 650;
        line-height: 1.2;
        text-decoration: none;
      }
      .more-nav-list a:hover {
        background: var(--surface-soft);
        color: var(--accent);
      }
      .more-nav-list a[aria-current="page"] {
        background: var(--surface-soft);
        color: var(--ink);
      }
      .header-tools {
        display: flex;
        align-items: center;
        gap: .35rem;
        flex: 0 0 auto;
      }
      .tool-button, .search-trigger {
        display: inline-grid;
        width: 2.45rem;
        height: 2.45rem;
        place-items: center;
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        background: transparent;
        color: var(--ink);
      }
      .tool-button:hover, .search-trigger:hover {
        border-color: var(--line-subtle);
        background: var(--surface);
      }
      .tool-button svg, .search-trigger svg {
        width: 1.1rem;
        height: 1.1rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.8;
      }
      .theme-toggle-btn .sun-icon { display: block; }
      .theme-toggle-btn .moon-icon, html.dark .theme-toggle-btn .sun-icon { display: none; }
      html.dark .theme-toggle-btn .moon-icon { display: block; }
      .utility-rss {
        padding: .3rem .5rem;
        border-radius: var(--radius-sm);
        color: var(--muted);
        font-size: .76rem;
        font-weight: 750;
        letter-spacing: .04em;
        text-decoration: none;
      }
      .utility-rss:hover { background: var(--surface-soft); color: var(--accent); }

      /* Simple Footer */
      .site-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        margin-top: var(--space-8);
        padding: 1.25rem 0 1.75rem;
        border-top: 1px solid var(--line-subtle);
        color: var(--muted);
        font-size: .84rem;
      }
      .footer-brand { display: flex; align-items: baseline; flex-wrap: wrap; gap: .4rem .85rem; }
      .footer-brand strong { color: var(--ink); font-family: var(--font-display); font-size: .95rem; }
      .footer-brand span { color: var(--muted); font-size: .82rem; }
      .footer-links { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem 1.15rem; }
      .footer-links a { color: var(--muted); font-weight: 650; text-decoration: none; }
      .footer-links a:hover { color: var(--accent); }

      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
      #scroll-to-top {
        position: fixed;
        right: max(1rem, calc((100vw - var(--container)) / 2));
        bottom: 1.25rem;
        z-index: 15;
        width: 2.75rem;
        height: 2.75rem;
        opacity: 0;
        pointer-events: none;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: var(--surface);
        color: var(--ink);
        box-shadow: var(--shadow-sm);
        transition: opacity .2s ease, transform .2s ease;
        transform: translateY(.5rem);
      }
      #scroll-to-top.visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
      #progress-bar { position: fixed; top: 0; left: 0; z-index: 100; width: 0; height: 3px; background: var(--accent); transition: width 0.1s ease-out; }
      pre, code { background: var(--code-bg); font-family: var(--font-mono); font-size: .9em; }
      pre { max-width: 100%; padding: 1.15rem; overflow: auto; border: 1px solid var(--line); border-radius: var(--radius-sm); color: #f4efe5; }
      code { padding: .15em .35em; border-radius: 4px; color: #f4efe5; }
      pre code { padding: 0; background: transparent; }

      @media (max-width: 820px) {
        .primary-nav { order: 3; width: 100%; padding-top: .35rem; border-top: 1px solid var(--line-subtle); }
      }
      @media (max-width: 620px) {
        body { width: min(100% - 1.5rem, var(--container)); }
        .site-header { margin: 0 0 1.25rem; padding: .5rem 0; }
        .site-brand { font-size: 1.02rem; }
        .header-tools { gap: .15rem; }
        .utility-rss { display: none; }
        .primary-nav { gap: .15rem; }
        .primary-nav > a, .more-nav > summary { height: 2.15rem; padding: 0 .6rem; font-size: .79rem; line-height: 1; white-space: nowrap; }
        .site-footer { flex-direction: column; align-items: flex-start; gap: .75rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="header-bar">
        <a class="site-brand" href={base('/')}>
          <span class="brand-mark" aria-hidden="true">A&amp;M</span>
          <span>Anime &amp; Mangá</span>
        </a>
        <nav class="primary-nav" aria-label="Navegação principal">
          <a href={base('/')} aria-current={routePath === '/' ? 'page' : undefined}>Início</a>
          <a href={base('/noticias/')} aria-current={isActive('/noticias/') ? 'page' : undefined}>Notícias</a>
          <a href={base('/animes/')} aria-current={isActive('/animes/') ? 'page' : undefined}>Anime</a>
          <a href={base('/mangas/')} aria-current={isActive('/mangas/') ? 'page' : undefined}>Mangá</a>
          <a href={base('/obras/')} aria-current={isActive('/obras/') ? 'page' : undefined}>Obras</a>
          <details class="more-nav" data-active={isMoreActive ? 'true' : undefined}>
            <summary>Mais editorias</summary>
            <div class="more-nav-list">
              <a href={base('/reviews/')} aria-current={isActive('/reviews/') ? 'page' : undefined}>Reviews</a>
              <a href={base('/guias/')} aria-current={isActive('/guias/') ? 'page' : undefined}>Guias</a>
              <a href={base('/temporadas/')} aria-current={isActive('/temporadas/') ? 'page' : undefined}>Temporadas</a>
            </div>
          </details>
        </nav>
        <div class="header-tools">
          <button id="search-open-btn" class="tool-button search-trigger" type="button" aria-label="Abrir busca" title="Pesquisar no site" aria-haspopup="dialog" aria-controls="search-dialog">
            <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
          </button>
          <a class="utility-rss" href={base('/rss.xml')}>RSS</a>
          <button id="theme-toggle" class="tool-button theme-toggle-btn" type="button" aria-label="Alternar tema claro ou escuro" title="Alternar tema">
            <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
            <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.3 15.3A8.5 8.5 0 0 1 8.7 3.7 8.7 8.7 0 1 0 20.3 15.3Z"></path></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>Anime &amp; Mangá</strong>
        <span>Publicações, análises e catálogo editorial.</span>
      </div>
      <nav class="footer-links" aria-label="Links complementares">
        <a href={base('/obras/')}>Catálogo</a>
        <a href={base('/temporadas/')}>Temporadas</a>
        <a href={base('/arquivo/')}>Arquivo</a>
        <a href={base('/rss.xml')}>Feed RSS</a>
        <a href="https://github.com/ErickG123" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </footer>
    <button id="scroll-to-top" type="button" title="Voltar ao topo" aria-label="Voltar ao topo">↑</button>
    <SearchDialog />

    <script>
      import '../scripts/site-search';
    </script>
    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle');
      const readTheme = () => {
        try { return localStorage.getItem('theme') === 'dark'; } catch { return false; }
      };
      const setTheme = (dark) => {
        document.documentElement.classList.toggle('dark', dark);
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch { /* Theme stays active for this page. */ }
        const iframe = document.querySelector('iframe.giscus-frame');
        iframe?.contentWindow?.postMessage({ giscus: { setConfig: { theme: dark ? 'noborder_dark' : 'light' } } }, 'https://giscus.app');
      };
      setTheme(readTheme());
      themeToggle?.addEventListener('click', () => setTheme(!document.documentElement.classList.contains('dark')));
      const scrollToTop = document.getElementById('scroll-to-top');
      window.addEventListener('scroll', () => scrollToTop?.classList.toggle('visible', window.scrollY > 360), { passive: true });
      scrollToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
  </body>
</html>
