---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import SectionHeading from '@shared/ui/SectionHeading.astro';
import TagChip from '@shared/ui/TagChip.astro';
import MediaFigure from '@shared/ui/MediaFigure.astro';
import { ROUTES } from '@shared/domain/rules';
import {
  getPublicCreators,
  getPublicEditions,
  getPublicPublishers,
  getPublicReviews,
  getPublicStudios,
  getPublicWorks,
} from '@features/content/content.selectors';

export async function getStaticPaths() {
  const works = await getPublicWorks();
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const [creators, publishers, studios, editions, reviews] = await Promise.all([
  getPublicCreators(),
  getPublicPublishers(),
  getPublicStudios(),
  getPublicEditions(),
  getPublicReviews(),
]);

const creatorMap = new Map(creators.map((c) => [c.id, c]));
const workPublishers = publishers.filter((p) => work.publisherIds?.includes(p.id));
const workStudios = studios.filter((s) => work.studioIds?.includes(s.id));
const workEditions = editions.filter((e) => e.workId === work.id);
const workReviews = reviews.filter((r) => r.workId === work.id);
---

<BaseLayout title={work.title} description={work.synopsis}>
  <article data-pagefind-body>
    <header class="ma-hero">
      <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
        <TagChip label={work.kind} variant="accent" />
        <TagChip label={work.format} />
        <TagChip label={work.publicationStatus} />
      </div>
      <h1>{work.title}</h1>
      {work.originalTitle && <p style="font-style: italic;">{work.originalTitle}</p>}
      <p>{work.synopsis}</p>
    </header>

    {work.cover && <MediaFigure asset={work.cover} eager />}

    <section class="ma-meta-box" aria-label="Ficha técnica">
      <dl>
        {work.releaseYear && (
          <div>
            <dt>Ano</dt>
            <dd>{work.releaseYear}</dd>
          </div>
        )}
        {work.country && (
          <div>
            <dt>País</dt>
            <dd>{work.country}</dd>
          </div>
        )}
        {work.credits.length > 0 && (
          <div>
            <dt>Criadores</dt>
            <dd>
              {work.credits.map((credit, idx) => {
                const creator = creatorMap.get(credit.creatorId);
                return (
                  <>
                    {idx > 0 && ', '}
                    {creator ? (
                      <a href={ROUTES.creator(creator.slug)}>{creator.name}</a>
                    ) : (
                      credit.creatorId
                    )}
                  </>
                );
              })}
            </dd>
          </div>
        )}
        {workPublishers.length > 0 && (
          <div>
            <dt>Editoras</dt>
            <dd>
              {workPublishers.map((pub, idx) => (
                <>
                  {idx > 0 && ', '}
                  <a href={ROUTES.publisher(pub.slug)}>{pub.name}</a>
                </>
              ))}
            </dd>
          </div>
        )}
        {workStudios.length > 0 && (
          <div>
            <dt>Estúdios</dt>
            <dd>
              {workStudios.map((studio, idx) => (
                <>
                  {idx > 0 && ', '}
                  <a href={ROUTES.studio(studio.slug)}>{studio.name}</a>
                </>
              ))}
            </dd>
          </div>
        )}
      </dl>
    </section>

    {workEditions.length > 0 && (
      <section style="margin-top: 2rem;">
        <SectionHeading title="Edições físicas catalogadas" />
        <div class="ma-grid">
          {workEditions.map((ed) => (
            <article class="ma-work-card">
              <h3>{ed.title}</h3>
              <p>
                {[ed.formatLabel, ed.paperType, ed.binding].filter(Boolean).join(' · ') ||
                  ed.language}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}

    {workReviews.length > 0 && (
      <section style="margin-top: 2rem;">
        <SectionHeading title="Reviews desta obra" />
        <ul class="ma-entry-list">
          {workReviews.map((rev) => (
            <li class="ma-entry">
              <h3 class="ma-entry__title">
                <a href={ROUTES.review(rev.slug)}>{rev.title}</a>
              </h3>
              <p class="ma-entry__summary">{rev.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
