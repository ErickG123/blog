---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import PostCard from '../../components/PostCard.astro';
import WorkCard from '../../components/WorkCard.astro';
import { render } from 'astro:content';
import { basePath, isPublicWork, publicPosts, seasonLabels } from '../../utils/content';
import { loadPosts, loadTaxonomies, loadWorks } from '../../utils/dev-fixtures';

export async function getStaticPaths() {
  const works = (await loadWorks()).filter(isPublicWork);
  return Promise.all(
    works.map(async (work) => {
      let rendered: Awaited<ReturnType<typeof render>> | undefined;
      try {
        if (!work.id.startsWith('fixture-')) {
          rendered = await render(work);
        }
      } catch {
        rendered = undefined;
      }
      return { params: { id: work.id }, props: { work, rendered } };
    }),
  );
}

const { work, rendered } = Astro.props;
const Content = rendered?.Content;
const [allPostsRaw, taxonomies, allWorks] = await Promise.all([loadPosts(), loadTaxonomies(), loadWorks()]);
const allPosts = publicPosts(allPostsRaw);
const relatedPosts = allPosts.filter((post) => post.data.works.some((reference) => reference.id === work.id));
const otherWorks = allWorks.filter((candidate) => isPublicWork(candidate) && candidate.id !== work.id);
const relatedWorks = work.data.relatedWorks
  .map((reference) => otherWorks.find((candidate) => candidate.id === reference.id))
  .filter((candidate) => candidate !== undefined);
const metadata = [work.data.releaseYear, work.data.season ? seasonLabels[work.data.season] : undefined, work.data.status].filter(Boolean);
const genres = [
  ...new Set([
    ...work.data.genres,
    ...work.data.genreRefs.map((reference) => taxonomies.find((taxonomy) => taxonomy.id === reference.id)?.data.name ?? reference.id),
  ]),
];
const coverSrc = work.data.cover
  ? (work.data.cover.startsWith('data:') || work.data.cover.startsWith('http') ? work.data.cover : basePath(work.data.cover))
  : undefined;
---

<Layout title={work.data.title} description={work.data.synopsis} type="article" image={coverSrc && !coverSrc.startsWith('data:') ? coverSrc : undefined}>
  <article class="work-page">
    <nav class="breadcrumbs" aria-label="Trilha de navegação">
      <a class="back-link" href={basePath('/obras/')}>← Catálogo de obras</a>
      {work.data.releaseYear && work.data.season && (
        <>
          <span aria-hidden="true">·</span>
          <a href={basePath(`/temporadas/${work.data.releaseYear}/${work.data.season}/`)}>
            {seasonLabels[work.data.season]} {work.data.releaseYear}
          </a>
        </>
      )}
    </nav>

    <div class="work-intro">
      <div class="work-cover-slot">
        {coverSrc ? (
          <figure class="cover-figure">
            <img class="cover" src={coverSrc} alt={work.data.coverAlt || `Capa de ${work.data.title}`} />
            {work.data.coverCredit && (
              <figcaption>
                Imagem: <a href={work.data.coverSource} target="_blank" rel="noopener noreferrer">{work.data.coverCredit}</a>
              </figcaption>
            )}
          </figure>
        ) : (
          <div class="cover-placeholder">Sem capa cadastrada</div>
        )}
      </div>

      <div class="intro-copy">
        <div class="badges">
          <span class="eyebrow">{work.data.mediaType === 'anime' ? 'Anime' : 'Mangá'}</span>
          {metadata.map((item) => <span class="meta-pill">{item}</span>)}
        </div>
        <h1>{work.data.title}</h1>
        {work.data.originalTitle && <p class="original">{work.data.originalTitle}</p>}
        <p class="synopsis-lead">{work.data.synopsis}</p>
        {genres.length > 0 && (
          <ul class="genres" aria-label="Gêneros">
            {genres.map((genre) => <li>{genre}</li>)}
          </ul>
        )}
      </div>
    </div>

    {work.body?.trim() && (
      <section class="details-section">
        <h2>Notas editoriais</h2>
        <div class="synopsis-body">
          {Content ? <Content /> : <p set:html={work.body.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />}
        </div>
      </section>
    )}

    {work.data.sources.length > 0 && (
      <section class="details-section">
        <h2>Fontes consultadas</h2>
        <ul class="source-list">
          {work.data.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.label}<span aria-hidden="true"> ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="details-section">
      <h2>Publicações sobre esta obra</h2>
      {relatedPosts.length > 0 ? (
        <div class="related-posts">
          {relatedPosts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <EmptyState title="Sem publicações associadas" message="Ainda não há reviews, notícias ou guias vinculados a esta ficha." />
      )}
    </section>

    {relatedWorks.length > 0 && (
      <section class="details-section">
        <h2>Obras relacionadas</h2>
        <div class="related-grid">
          {relatedWorks.map((item) => <WorkCard work={item} />)}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .work-page {
    display: grid;
    gap: 2rem;
  }
  .breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .5rem;
    font-size: .84rem;
  }
  .back-link {
    color: var(--muted);
    font-weight: 650;
    text-decoration: none;
  }
  .back-link:hover { color: var(--accent); }
  .work-intro {
    display: grid;
    grid-template-columns: 15.5rem minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .work-cover-slot { min-width: 0; }
  .cover-figure { margin: 0; }
  .cover-placeholder {
    display: grid;
    width: 100%;
    aspect-ratio: 3 / 4;
    place-items: center;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
    color: var(--muted);
    font-size: .84rem;
    font-weight: 600;
  }
  .cover {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
  }
  figcaption {
    margin-top: .45rem;
    color: var(--muted);
    font-size: .74rem;
  }
  .intro-copy {
    display: grid;
    gap: .65rem;
    min-width: 0;
  }
  .badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .45rem;
  }
  .eyebrow {
    padding: .2rem .55rem;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .meta-pill {
    padding: .2rem .55rem;
    border-radius: 4px;
    background: var(--surface-soft);
    color: var(--muted);
    font-size: .76rem;
    font-weight: 700;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3.6vw, 2.6rem);
    line-height: 1.18;
    letter-spacing: -.03em;
    overflow-wrap: anywhere;
  }
  .original {
    margin: -.2rem 0 0;
    color: var(--muted);
    font-size: .95rem;
    font-weight: 500;
  }
  .synopsis-lead {
    max-width: 65ch;
    margin: .25rem 0 0;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.65;
  }
  .genres {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin: .35rem 0 0;
    padding: 0;
    list-style: none;
  }
  .genres li {
    padding: .22rem .6rem;
    border-radius: 4px;
    background: var(--surface-soft);
    color: var(--blue);
    font-size: .76rem;
    font-weight: 700;
  }
  .details-section {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-subtle);
  }
  h2 {
    margin: 0 0 1rem;
    font-size: 1.35rem;
  }
  .synopsis-body {
    max-width: 68ch;
    color: var(--muted);
    line-height: 1.7;
  }
  .source-list {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem 1.5rem;
    margin: 0;
    padding-left: 1.1rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .related-posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 860px) {
    .work-intro { grid-template-columns: 12rem minmax(0, 1fr); }
    .related-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .work-intro { grid-template-columns: 1fr; }
    .work-cover-slot { max-width: 13rem; }
    .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
    .related-posts { grid-template-columns: 1fr; }
  }
</style>
