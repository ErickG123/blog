---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import TagChip from '@shared/ui/TagChip.astro';
import EmptyState from '@shared/ui/EmptyState.astro';
import ListControls from '@shared/ui/ListControls.astro';
import { ROUTES } from '@shared/domain/rules';
import { formatWorkFormat, formatWorkKind } from '@shared/utils/i18n';
import { PAGINATION_LIMITS } from '@shared/config/pagination';
import { getPublicWorks } from '@features/content/content.selectors';

const works = await getPublicWorks();
---

<BaseLayout
  title="Biblioteca de obras"
  description="Catálogo factual de mangás, animes e manhwas comentados no Mangá Atlas."
>
  <section class="ma-hero">
    <h1>Biblioteca de obras</h1>
    <p>
      Fichas factuais separadas de opiniões críticas, conectando obras, criadores, editoras,
      estúdios e publicações do blog.
    </p>
  </section>

  {works.length > 0 ? (
    <>
      <ListControls
        containerSelector="[data-works-grid]"
        itemSelector="[data-list-item]"
        pageSize={PAGINATION_LIMITS.works}
        nounPlural="obras"
        filterParam="tipo"
        filterOptions={[
          { value: 'all', label: `Todas (${works.length})` },
          { value: 'manga', label: `Mangá (${works.filter((w) => w.kind === 'manga').length})` },
          { value: 'anime', label: `Anime (${works.filter((w) => w.kind === 'anime').length})` },
          {
            value: 'manhwa',
            label: `Manhwa (${works.filter((w) => w.kind === 'manhwa').length})`,
          },
        ]}
      />

      <div class="ma-grid" data-works-grid>
        {works.map((work) => (
          <article
            class="ma-work-card"
            data-list-item
            data-filter-key={work.kind}
            data-sort-title={work.title}
            data-sort-date={String(work.releaseYear ?? 0)}
          >
            {work.cover && (
              <div class="ma-work-card__cover">
                <img
                  src={work.cover.src}
                  alt={work.cover.alt}
                  width={work.cover.width}
                  height={work.cover.height}
                  loading="lazy"
                />
              </div>
            )}
            <div class="ma-work-card__body">
              <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                <TagChip label={formatWorkKind(work.kind)} variant="accent" />
                <TagChip label={formatWorkFormat(work.format)} />
              </div>
              <h2>
                <a href={ROUTES.work(work.slug)}>{work.title}</a>
              </h2>
              {work.originalTitle && <p style="font-style: italic;">{work.originalTitle}</p>}
            </div>
          </article>
        ))}
      </div>
    </>
  ) : (
    <EmptyState
      title="Nenhuma obra pública cadastrada"
      description="Quando obras autorizadas forem adicionadas à coleção, suas fichas aparecerão aqui."
    />
  )}
</BaseLayout>
