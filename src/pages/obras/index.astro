---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import WorkCard from '../../components/WorkCard.astro';
import { basePath, isPublicWork, seasonLabels } from '../../utils/content';
import { loadTaxonomies, loadWorks } from '../../utils/dev-fixtures';
import { taxonomyId } from '../../utils/work-filters';

const [allWorks, taxonomies] = await Promise.all([loadWorks(), loadTaxonomies()]);
const works = allWorks.filter(isPublicWork).sort((a, b) => a.id.localeCompare(b.id));
const genreTaxonomies = taxonomies.filter((taxonomy) => taxonomy.data.type === 'genre');
const genreLabelsById = new Map(genreTaxonomies.map((taxonomy) => [taxonomy.id, taxonomy.data.name]));
const workRecords = works.map((work) => {
  const genreIds = [...new Set([...work.data.genreRefs.map((reference) => reference.id), ...work.data.genres.map(taxonomyId)])];
  const genres = [...new Set([...work.data.genres, ...work.data.genreRefs.map((reference) => genreLabelsById.get(reference.id) ?? reference.id)])];
  return {
    id: work.id,
    title: work.data.title,
    originalTitle: work.data.originalTitle,
    synopsis: work.data.synopsis,
    mediaType: work.data.mediaType,
    releaseYear: work.data.releaseYear,
    season: work.data.season,
    genres,
    genreIds,
  };
});
const genreOptions = new Map(genreTaxonomies.map((taxonomy) => [taxonomy.id, taxonomy.data.name]));
for (const work of workRecords) {
  for (const genre of work.genres) {
    genreOptions.set(taxonomyId(genre), genreOptions.get(taxonomyId(genre)) ?? genre);
  }
}
const years = [...new Set(workRecords.flatMap((work) => (work.releaseYear ? [work.releaseYear] : [])))].sort((a, b) => b - a);
---

<Layout title="Catálogo de obras" description="Explore o catálogo editorial de obras de anime e mangá.">
  <section class="catalog-page" aria-labelledby="catalog-title">
    <header class="catalog-heading">
      <div class="heading-top">
        <a class="back-link" href={basePath('/')}>← Início</a>
        <a class="season-shortcut" href={basePath('/temporadas/')}>Ver temporadas →</a>
      </div>
      <h1 id="catalog-title">Catálogo de obras</h1>
      <p>Busque por título ou filtre fichas de anime e mangá por tipo, gênero, ano e temporada.</p>
    </header>

    {works.length === 0 ? (
      <EmptyState
        title="O catálogo está vazio"
        message="As fichas editoriais de anime e mangá aparecerão aqui conforme forem verificadas e publicadas."
        actionHref={basePath('/')}
        actionLabel="Voltar para a Home"
      />
    ) : (
      <>
        <form id="work-filters" class="filters" role="search" aria-label="Filtrar catálogo">
          <label class="query-field" for="work-query">
            <span>Buscar uma obra</span>
            <input id="work-query" name="query" type="search" autocomplete="off" placeholder="Título, sinopse ou gênero" />
          </label>
          <label for="work-type">
            <span>Tipo de obra</span>
            <select id="work-type" name="mediaType">
              <option value="">Todos</option>
              <option value="anime">Anime</option>
              <option value="manga">Mangá</option>
            </select>
          </label>
          <label for="work-genre">
            <span>Gênero</span>
            <select id="work-genre" name="genre">
              <option value="">Todos</option>
              {[...genreOptions].sort((a, b) => a[1].localeCompare(b[1], 'pt-BR')).map(([id, label]) => (
                <option value={id}>{label}</option>
              ))}
            </select>
          </label>
          <label for="work-year">
            <span>Ano</span>
            <select id="work-year" name="year">
              <option value="">Todos</option>
              {years.map((year) => <option value={year}>{year}</option>)}
            </select>
          </label>
          <label for="work-season">
            <span>Temporada</span>
            <select id="work-season" name="season">
              <option value="">Todas</option>
              {Object.entries(seasonLabels).map(([season, label]) => (
                <option value={season}>{label}</option>
              ))}
            </select>
          </label>
          <button type="reset" class="reset">Limpar filtros</button>
        </form>

        <div class="results-heading">
          <p id="filter-count" role="status" aria-live="polite"></p>
        </div>

        <div id="work-catalog" class="work-grid" data-works={JSON.stringify(workRecords)}>
          {works.map((work) => <WorkCard work={work} />)}
        </div>

        <EmptyState
          title="Nenhuma obra encontrada"
          message="Tente outros termos ou limpe os filtros para ver o catálogo completo."
          hidden={true}
        />
      </>
    )}
  </section>

  <script>
    import '../../scripts/work-catalog';
  </script>
</Layout>

<style>
  .catalog-page {
    display: grid;
    gap: 1.35rem;
  }
  .catalog-heading {
    display: grid;
    gap: .4rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line-subtle);
  }
  .heading-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .2rem;
  }
  .back-link,
  .season-shortcut {
    font-size: .82rem;
    font-weight: 650;
    text-decoration: none;
  }
  .back-link { color: var(--muted); }
  .back-link:hover { color: var(--accent); }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -.03em;
  }
  .catalog-heading > p:last-child {
    max-width: 60ch;
    margin: 0;
    color: var(--muted);
    font-size: .96rem;
  }
  .filters {
    display: grid;
    grid-template-columns: 1.8fr repeat(4, minmax(0, 1fr)) auto;
    gap: .75rem;
    align-items: end;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .filters label {
    display: grid;
    gap: .35rem;
    min-width: 0;
    color: var(--muted);
    font-size: .78rem;
    font-weight: 650;
  }
  .filters input,
  .filters select {
    width: 100%;
    min-width: 0;
    min-height: 2.55rem;
    padding: .45rem .65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font-size: .86rem;
  }
  .reset {
    min-height: 2.55rem;
    padding: .45rem .85rem;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-soft);
    color: var(--ink);
    font-size: .82rem;
    font-weight: 700;
  }
  .reset:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .results-heading {
    margin: -.25rem 0;
    color: var(--muted);
    font-size: .84rem;
    font-weight: 600;
  }
  #filter-count { margin: 0; }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .work-grid[hidden],
  .work-card[hidden],
  .empty-state[hidden] {
    display: none !important;
  }
  @media (max-width: 980px) {
    .filters { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .query-field { grid-column: 1 / -1; }
    .work-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reset { grid-column: 1 / -1; }
    .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; }
  }
  @media (max-width: 380px) {
    .work-grid { grid-template-columns: 1fr; }
  }
</style>
