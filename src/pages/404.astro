---
import Layout from '../layouts/Layout.astro';
import { basePath } from '../utils/content';
---

<Layout title="Página não encontrada">
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found-card">
      <p class="code">Erro 404</p>
      <h1 id="not-found-title">Página não encontrada</h1>
      <p class="message">O endereço solicitado pode ter mudado, estar incompleto ou ainda não existir no blog.</p>
      <div class="actions">
        <a class="home-link" href={basePath('/')}>Voltar ao início</a>
        <a class="secondary-link" href={basePath('/obras/')}>Explorar catálogo</a>
        <a class="secondary-link" href={basePath('/noticias/')}>Ver notícias</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    display: grid;
    place-items: center;
    padding: 2.5rem 0;
  }
  .not-found-card {
    width: min(100%, 40rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .code {
    display: inline-block;
    margin: 0 0 .6rem;
    padding: .2rem .55rem;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -.03em;
  }
  .message {
    margin: .6rem 0 1.35rem;
    color: var(--muted);
    font-size: .96rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    align-items: center;
  }
  .home-link,
  .secondary-link {
    padding: .55rem .95rem;
    border-radius: var(--radius-sm);
    font-size: .86rem;
    font-weight: 700;
    text-decoration: none;
  }
  .home-link {
    background: var(--ink);
    color: var(--paper);
  }
  .home-link:hover {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .secondary-link {
    border: 1px solid var(--line-subtle);
    background: var(--surface-soft);
    color: var(--ink);
  }
  .secondary-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
