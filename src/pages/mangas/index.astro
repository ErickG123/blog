---
import Layout from '../../layouts/Layout.astro';
import PostListing from '../../components/PostListing.astro';
import { postsOfType } from '../../utils/content';
import { loadPosts } from '../../utils/dev-fixtures';

const posts = postsOfType(await loadPosts(), 'manga');
---
<Layout title="Artigos sobre mangá">
  <PostListing title="Mangá" description="Artigos, análises de narrativa visual e caminhos de leitura sobre mangá." posts={posts} />
</Layout>
