---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { basePath, formatDate, isPublicWork, postDate, postUpdatedDate, publicPosts, readingTime, typeLabels } from '../../utils/content';
import { loadAuthors, loadPosts, loadTaxonomies, loadWorks } from '../../utils/dev-fixtures';

export async function getStaticPaths() {
  const sortedPosts = publicPosts(await loadPosts());

  return sortedPosts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: sortedPosts[index + 1] || null,
      nextPost: sortedPosts[index - 1] || null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
let Content: Awaited<ReturnType<typeof render>>['Content'] | undefined;
let headings: { depth: number; slug: string; text: string }[];

try {
  const rendered = await render(post);
  if (rendered.headings.length > 0 || !post.id.startsWith('fixture-')) {
    Content = rendered.Content;
    headings = rendered.headings;
  } else {
    throw new Error('Synthetic fixture entry');
  }
} catch {
  // Dev fixtures are synthetic objects not backed by the Markdown file loader.
  const headingMatches = [...(post.body ?? '').matchAll(/^(#{2,3})\s+(.+)$/gm)];
  headings = headingMatches.map((match) => {
    const depth = match[1].length;
    const text = match[2].trim();
    const slug = text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-');
    return { depth, slug, text };
  });
}

// Render simple markdown paragraphs/headings when Content is not available (fixture mode)
const renderFallbackHtml = (markdown = '') => {
  return markdown
    .split(/\n\n+/)
    .map((block) => {
      const trimmed = block.trim();
      if (trimmed.startsWith('### ')) {
        const text = trimmed.slice(4).trim();
        const slug = text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-');
        return `<h3 id="${slug}">${text}</h3>`;
      }
      if (trimmed.startsWith('## ')) {
        const text = trimmed.slice(3).trim();
        const slug = text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-');
        return `<h2 id="${slug}">${text}</h2>`;
      }
      if (trimmed.startsWith('```')) {
        const code = trimmed.replace(/^```\w*\n?/, '').replace(/```$/, '');
        return `<pre><code>${code.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code></pre>`;
      }
      if (trimmed.startsWith('> ')) {
        const inner = trimmed.replace(/^>\s?/gm, '');
        return `<blockquote><p>${inner}</p></blockquote>`;
      }
      const formatted = trimmed
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/`(.+?)`/g, '<code>$1</code>');
      return `<p>${formatted}</p>`;
    })
    .join('\n');
};

const showToc = headings.length >= 2;
const formattedDate = formatDate(postDate(post));
const updatedDate = postUpdatedDate(post);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
const minutesToRead = readingTime(post.body);

const postUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const xShareUrl = `https://x.com/intent/post?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`;

const giscusRepo = import.meta.env.PUBLIC_GISCUS_REPO || 'ErickG123/blog';
const giscusRepoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || 'R_kgDOUSrohA';
const giscusCategory = import.meta.env.PUBLIC_GISCUS_CATEGORY || 'General';
const giscusCategoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || 'DIC_kwDOUSrohM4DFKsr';
const giscusConfigured = [giscusRepo, giscusRepoId, giscusCategory, giscusCategoryId].every((value) => Boolean(value) && !value.startsWith('SEU_'));

const [allWorks, authors, taxonomyEntries, allPosts] = await Promise.all([
  loadWorks(),
  loadAuthors(),
  loadTaxonomies(),
  loadPosts(),
]);

const relatedWorks = allWorks.filter(isPublicWork);
const author = post.data.author ? authors.find((item) => item.id === post.data.author?.id) : undefined;
const works = post.data.works.map((reference) => relatedWorks.find((item) => item.id === reference.id)).filter(Boolean);
const postTags = [
  ...post.data.tags.map((id) => ({ id, label: id })),
  ...post.data.taxonomyRefs
    .map((reference) => taxonomyEntries.find((item) => item.id === reference.id && item.data.type === 'tag'))
    .filter((item) => item !== undefined)
    .map((item) => ({ id: item.id, label: item.data.name })),
];
const postWorkIds = post.data.works.map((reference) => reference.id);
const relatedPosts = publicPosts(allPosts)
  .filter((item) => item.id !== post.id && item.data.works.some((reference) => postWorkIds.includes(reference.id)))
  .slice(0, 3);

const coverSrc = post.data.cover
  ? (post.data.cover.startsWith('data:') || post.data.cover.startsWith('http') ? post.data.cover : basePath(post.data.cover))
  : undefined;

const spoilerLabels: Record<string, string> = {
  light: 'leves',
  moderate: 'moderados',
  heavy: 'importantes',
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: new Date(`${postDate(post)}T12:00:00Z`).toISOString(),
  ...(updatedDate ? { dateModified: new Date(`${updatedDate}T12:00:00Z`).toISOString() } : {}),
  mainEntityOfPage: postUrl,
  author: author ? { '@type': 'Person', name: author.data.name } : { '@type': 'Organization', name: 'Anime & Mangá' },
  ...(post.data.cover && !post.data.cover.startsWith('data:') && Astro.site ? { image: new URL(basePath(post.data.cover), Astro.site).toString() } : {}),
};
---

<Layout title={post.data.title} description={post.data.description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')} />
  <div id="progress-bar" aria-hidden="true"></div>

  <article class="article-shell">
    <header class="article-header">
      <div class="breadcrumbs">
        <a href={basePath('/')} class="back-link">← Início</a>
        <span aria-hidden="true">/</span>
        {post.data.type === 'article' ? (
          <a href={basePath('/arquivo/')}>{typeLabels[post.data.type]}</a>
        ) : (
          <a href={basePath(`/${({ news: 'noticias', anime: 'animes', manga: 'mangas', review: 'reviews', guide: 'guias' }[post.data.type])}/`)}>
            {typeLabels[post.data.type]}
          </a>
        )}
      </div>

      <div class="header-badges">
        <span class="category-label">{typeLabels[post.data.type]}</span>
        {post.data.rating !== undefined && <span class="rating-pill">Nota {post.data.rating.toFixed(1)} / 10</span>}
      </div>

      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>

      <div class="post-meta">
        <time datetime={`${postDate(post)}T12:00:00Z`}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{minutesToRead} min de leitura</span>
        {formattedUpdatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span class="updated-date">Atualizado em {formattedUpdatedDate}</span>
          </>
        )}
        {author && (
          <>
            <span aria-hidden="true">·</span>
            <span class="author">Por <strong>{author.data.name}</strong></span>
          </>
        )}
      </div>

      {postTags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {postTags.map(({ id, label }) => (
            <li><a href={basePath(`/tags/${encodeURIComponent(id)}/`)} class="tag">#{label}</a></li>
          ))}
        </ul>
      )}
    </header>

    {coverSrc && (
      <figure class="article-figure">
        <img class="article-cover" src={coverSrc} alt={post.data.coverAlt || `Capa de ${post.data.title}`} />
        {post.data.coverCredit && (
          <figcaption>
            Imagem: <a href={post.data.coverSource} target="_blank" rel="noopener noreferrer">{post.data.coverCredit}</a>
          </figcaption>
        )}
      </figure>
    )}

    <div class:list={['article-body-grid', { 'has-toc': showToc }]}>
      <div class="article-main">
        {post.data.spoilerLevel && post.data.spoilerLevel !== 'none' && (
          <aside class="spoiler" role="note">
            <strong>Aviso de spoiler</strong>
            <span>Este artigo contém spoilers {spoilerLabels[post.data.spoilerLevel] ?? post.data.spoilerLevel}.</span>
          </aside>
        )}

        <div class="content">
          {Content ? <Content /> : <Fragment set:html={renderFallbackHtml(post.body)} />}
        </div>

        {(post.data.sources.length > 0 || works.length > 0) && (
          <div class="article-references">
            {works.length > 0 && (
              <section class="ref-box related-works">
                <h2>Obras abordadas</h2>
                <ul>
                  {works.map((work) => (
                    <li>
                      <a href={basePath(`/obras/${work!.id}/`)}>{work!.data.title}</a>
                      <span class="ref-type">{work!.data.mediaType === 'anime' ? 'Anime' : 'Mangá'}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}
            {post.data.sources.length > 0 && (
              <section class="ref-box sources">
                <h2>Fontes e referências</h2>
                <ul>
                  {post.data.sources.map((source) => (
                    <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a></li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        )}

        <div class="share-section">
          <span class="share-label">Compartilhar publicação:</span>
          <div class="share-links">
            <a href={xShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn">Postar no X</a>
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="share-btn">LinkedIn</a>
            <button id="copy-link-btn" type="button" data-url={postUrl} class="share-btn">Copiar link</button>
          </div>
        </div>

        {(prevPost || nextPost) && (
          <nav class="post-nav" aria-label="Navegação entre artigos">
            <div class="nav-prev">
              {prevPost && (
                <a href={basePath(`/posts/${prevPost.id}/`)} class="nav-link">
                  <small>← Artigo anterior</small>
                  <span>{prevPost.data.title}</span>
                </a>
              )}
            </div>
            <div class="nav-next">
              {nextPost && (
                <a href={basePath(`/posts/${nextPost.id}/`)} class="nav-link">
                  <small>Próximo artigo →</small>
                  <span>{nextPost.data.title}</span>
                </a>
              )}
            </div>
          </nav>
        )}

        {relatedPosts.length > 0 && (
          <section class="related-posts" aria-labelledby="related-posts-heading">
            <h2 id="related-posts-heading">Publicações relacionadas</h2>
            <div class="related-list">
              {relatedPosts.map((item) => <PostCard post={item} variant="compact" />)}
            </div>
          </section>
        )}

        <section class="comments-section" aria-label="Comentários">
          {giscusConfigured ? (
            <div id="giscus-container"></div>
          ) : (
            <p class="comments-fallback">Comentários indisponíveis no momento. Você pode compartilhar este artigo pelos links acima.</p>
          )}
        </section>

        {giscusConfigured && (
          <script is:inline define:vars={{ giscusRepo, giscusRepoId, giscusCategory, giscusCategoryId }}>
            (function initGiscus() {
              const isDark = document.documentElement.classList.contains('dark') || localStorage.getItem('theme') === 'dark';
              const theme = isDark ? 'noborder_dark' : 'light';

              const script = document.createElement('script');
              script.src = 'https://giscus.app/client.js';
              script.setAttribute('data-repo', giscusRepo);
              script.setAttribute('data-repo-id', giscusRepoId);
              script.setAttribute('data-category', giscusCategory);
              script.setAttribute('data-category-id', giscusCategoryId);
              script.setAttribute('data-mapping', 'pathname');
              script.setAttribute('data-strict', '0');
              script.setAttribute('data-reactions-enabled', '1');
              script.setAttribute('data-emit-metadata', '0');
              script.setAttribute('data-input-position', 'bottom');
              script.setAttribute('data-theme', theme);
              script.setAttribute('data-lang', 'pt');
              script.setAttribute('crossorigin', 'anonymous');
              script.async = true;

              document.getElementById('giscus-container')?.appendChild(script);
            })();
          </script>
        )}
      </div>

      {showToc && (
        <aside class="sidebar" aria-label="Índice do artigo">
          <div class="sidebar-content">
            <h2>Neste artigo</h2>
            <ul class="toc-list">
              {headings.map((heading: { depth: number; slug: string; text: string }) => (
                <li style={`padding-left: ${Math.max(0, heading.depth - 2) * 0.85}rem`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </article>

  <script is:inline>
    window.addEventListener('scroll', () => {
      const progressBar = document.getElementById('progress-bar');
      if (!progressBar) return;
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      progressBar.style.width = scrolled + '%';
    });

    document.addEventListener("DOMContentLoaded", () => {
      const copyLinkBtn = document.getElementById("copy-link-btn");
      if (copyLinkBtn) {
        copyLinkBtn.addEventListener("click", async () => {
          const url = copyLinkBtn.getAttribute("data-url") || window.location.href;
          try {
            await navigator.clipboard.writeText(url);
            const originalText = copyLinkBtn.innerText;
            copyLinkBtn.innerText = "Link copiado!";
            setTimeout(() => {
              copyLinkBtn.innerText = originalText;
            }, 2000);
          } catch (err) {
            console.error("Falha ao copiar link: ", err);
          }
        });
      }

      const blockquotes = document.querySelectorAll(".content blockquote");
      blockquotes.forEach((bq) => {
        const firstP = bq.querySelector("p");
        if (!firstP) return;
        const text = firstP.innerHTML;
        const match = text.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*(.*)/is);
        if (match) {
          const type = match[1].toLowerCase();
          bq.setAttribute("data-alert", type);
          const badgeText = match[1].toUpperCase();
          const restText = match[2];
          firstP.innerHTML = `<strong class="alert-title alert-title-${type}">${badgeText}</strong>${restText ? '<br/>' + restText : ''}`;
        }
      });

      const codeBlocks = document.querySelectorAll(".content pre");
      codeBlocks.forEach((pre) => {
        pre.style.position = "relative";
        const copyBtn = document.createElement("button");
        copyBtn.type = "button";
        copyBtn.className = "copy-btn";
        copyBtn.innerText = "Copiar";
        copyBtn.addEventListener("click", async () => {
          const code = pre.querySelector("code");
          const text = code ? code.innerText : pre.innerText;
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.innerText = "Copiado!";
            setTimeout(() => {
              copyBtn.innerText = "Copiar";
            }, 2000);
          } catch (err) {
            console.error("Falha ao copiar texto: ", err);
          }
        });
        pre.appendChild(copyBtn);
      });
    });
  </script>
</Layout>

<style>
  .article-shell {
    max-width: 64rem;
    margin: 0 auto;
  }

  .article-body-grid {
    display: grid;
    grid-template-columns: minmax(0, 48rem);
    justify-content: center;
    gap: 2rem;
    margin-top: 1.75rem;
  }
  .article-header {
    max-width: 48rem;
    margin: 0 auto;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line-subtle);
  }
  .article-shell:has(.has-toc) .article-header {
    max-width: 100%;
  }
  @media (min-width: 1024px) {
    .article-body-grid.has-toc {
      grid-template-columns: minmax(0, 45rem) 16.5rem;
      align-items: start;
      justify-content: space-between;
      gap: 2.5rem;
    }
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .45rem;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: .82rem;
  }
  .breadcrumbs a {
    color: var(--muted);
    font-weight: 650;
    text-decoration: none;
  }
  .breadcrumbs a:hover { color: var(--accent); }

  .header-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: .65rem;
  }
  .category-label {
    display: inline-flex;
    padding: .2rem .55rem;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .rating-pill {
    display: inline-flex;
    padding: .2rem .55rem;
    border-radius: 4px;
    background: var(--surface-soft);
    color: var(--ink);
    font-size: .75rem;
    font-weight: 750;
  }

  .post-title {
    margin: 0;
    font-size: clamp(1.75rem, 3.6vw, 2.65rem);
    line-height: 1.18;
    letter-spacing: -.03em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .post-description {
    margin: .75rem 0 0;
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.6;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .45rem .65rem;
    margin: 1.05rem 0 0;
    color: var(--muted);
    font-size: .84rem;
    line-height: 1.4;
  }
  .author strong { color: var(--ink); }

  .tags {
    display: flex;
    gap: .45rem;
    margin: .95rem 0 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    height: 1.75rem;
    font-size: .78rem;
    font-weight: 600;
    line-height: 1;
    color: var(--blue);
    background: var(--surface-soft);
    padding: 0 .6rem;
    border-radius: 4px;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .article-figure {
    max-width: 48rem;
    margin: 1.5rem auto 0;
  }
  .article-shell:has(.has-toc) .article-figure {
    max-width: 100%;
  }
  .article-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
  }
  .article-figure figcaption {
    margin-top: .45rem;
    color: var(--muted);
    font-size: .78rem;
  }

  .sidebar-content {
    position: sticky;
    top: 2rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .sidebar-content h2 {
    margin: 0 0 .75rem;
    font-size: .9rem;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }
  .toc-list a {
    color: var(--muted);
    font-size: .85rem;
    text-decoration: none;
    display: block;
    line-height: 1.4;
  }
  .toc-list a:hover { color: var(--accent); }

  .spoiler {
    display: grid;
    gap: .2rem;
    padding: .9rem 1.1rem;
    margin: 0 0 1.5rem;
    border: 1px solid var(--line-subtle);
    border-left: 4px solid #d97706;
    background: var(--surface);
    border-radius: var(--radius-sm);
    font-size: .9rem;
  }
  .spoiler strong { color: #b45309; }
  html.dark .spoiler strong { color: #fbbf24; }

  .content {
    font-size: 1.03rem;
    line-height: 1.75;
  }
  .content :global(h2) {
    margin: 2.2rem 0 .85rem;
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
  }
  .content :global(h3) {
    margin: 1.75rem 0 .65rem;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
  }
  .content :global(p) {
    margin: 0 0 1.35rem;
  }
  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1.35rem;
    padding-left: 1.35rem;
  }
  .content :global(li) {
    margin-bottom: .35rem;
  }

  .content :global(blockquote) {
    border: 1px solid var(--line-subtle);
    border-left: 4px solid var(--line);
    padding: .9rem 1.15rem;
    background: var(--surface);
    border-radius: var(--radius-sm);
    margin: 1.5rem 0;
    color: var(--ink);
  }
  .content :global(blockquote p:last-child) { margin-bottom: 0; }
  .content :global(blockquote[data-alert="note"]) { border-left-color: var(--accent); }
  .content :global(blockquote[data-alert="tip"]) { border-left-color: #10b981; }
  .content :global(blockquote[data-alert="important"]) { border-left-color: #8b5cf6; }
  .content :global(blockquote[data-alert="warning"]) { border-left-color: #eab308; }
  .content :global(blockquote[data-alert="caution"]) { border-left-color: #ef4444; }

  .content :global(.alert-title) {
    display: block;
    margin-bottom: .35rem;
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .content :global(.alert-title-note) { color: var(--accent); }
  .content :global(.alert-title-tip) { color: #10b981; }
  .content :global(.alert-title-important) { color: #8b5cf6; }
  .content :global(.alert-title-warning) { color: #d97706; }
  .content :global(.alert-title-caution) { color: #ef4444; }

  .content :global(pre) { position: relative; margin: 1.5rem 0; }
  .content :global(.copy-btn) {
    position: absolute;
    top: .6rem;
    right: .6rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: .2rem .55rem;
