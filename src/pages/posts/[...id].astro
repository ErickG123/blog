---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { basePath, formatDate, isPublicWork, postDate, postUpdatedDate, publicPosts, readingTime, typeLabels } from '../../utils/content';

export async function getStaticPaths() {
  const sortedPosts = publicPosts(await getCollection('posts'));

  return sortedPosts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: sortedPosts[index + 1] || null,
      nextPost: sortedPosts[index - 1] || null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = formatDate(postDate(post));
const updatedDate = postUpdatedDate(post);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
const minutesToRead = readingTime(post.body);

const postUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const xShareUrl = `https://x.com/intent/post?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`;

const giscusRepo = import.meta.env.PUBLIC_GISCUS_REPO || 'ErickG123/blog';
const giscusRepoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || 'R_kgDOUSrohA';
const giscusCategory = import.meta.env.PUBLIC_GISCUS_CATEGORY || 'General';
const giscusCategoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || 'DIC_kwDOUSrohM4DFKsr';
const giscusConfigured = [giscusRepo, giscusRepoId, giscusCategory, giscusCategoryId].every((value) => Boolean(value) && !value.startsWith('SEU_'));
const relatedWorks = (await getCollection('works')).filter(isPublicWork);
const authors = await getCollection('authors');
const author = post.data.author ? authors.find((item) => item.id === post.data.author?.id) : undefined;
const works = post.data.works.map((reference) => relatedWorks.find((item) => item.id === reference.id)).filter(Boolean);
const taxonomyEntries = await getCollection('taxonomies');
const postTags = [
  ...post.data.tags.map((id) => ({ id, label: id })),
  ...post.data.taxonomyRefs.map((reference) => taxonomyEntries.find((item) => item.id === reference.id && item.data.type === 'tag')).filter((item) => item !== undefined).map((item) => ({ id: item.id, label: item.data.name })),
];
const postWorkIds = post.data.works.map((reference) => reference.id);
const relatedPosts = publicPosts(await getCollection('posts')).filter((item) => item.id !== post.id && item.data.works.some((reference) => postWorkIds.includes(reference.id))).slice(0, 3);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: new Date(`${postDate(post)}T12:00:00Z`).toISOString(),
  ...(updatedDate ? { dateModified: new Date(`${updatedDate}T12:00:00Z`).toISOString() } : {}),
  mainEntityOfPage: postUrl,
  author: author ? { '@type': 'Person', name: author.data.name } : { '@type': 'Organization', name: 'Anime & Mangá' },
  ...(post.data.cover && Astro.site ? { image: new URL(basePath(post.data.cover), Astro.site).toString() } : {}),
};
---

<Layout title={post.data.title} description={post.data.description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')} />
  <div id="progress-bar" aria-hidden="true"></div>

  <div class="layout-grid">
    <div class="main-content">
      <a href={basePath('/')} class="back-link">← Voltar para o feed</a>
      <article>
        <span class="post-date">
          {formattedDate} · {minutesToRead} min de leitura
          {formattedUpdatedDate && <span class="updated-date">(Atualizado em: {formattedUpdatedDate})</span>}
        </span>

        {/* Force rendering tags */}
        {postTags.length > 0 && (
          <div class="tags">
            {postTags.map(({ id, label }) => (
              <a href={basePath(`/tags/${encodeURIComponent(id)}/`)} class="tag">#{label}</a>
            ))}
          </div>
        )}

        <div class="breadcrumbs"><a href={basePath('/')}>Início</a><span aria-hidden="true"> / </span>{post.data.type === 'article' ? <span>{typeLabels[post.data.type]}</span> : <a href={basePath(`/${({news:'noticias',anime:'animes',manga:'mangas',review:'reviews',guide:'guias'}[post.data.type])}/`)}>{typeLabels[post.data.type]}</a>}</div>
        <p class="category-label">{typeLabels[post.data.type]}</p>
        {post.data.cover && <figure class="article-figure"><img class="article-cover" src={basePath(post.data.cover)} alt={post.data.coverAlt || `Capa de ${post.data.title}`} />{post.data.coverCredit && <figcaption>Imagem: <a href={post.data.coverSource} target="_blank" rel="noopener noreferrer">{post.data.coverCredit}</a></figcaption>}</figure>}
        <h1 class="post-title">{post.data.title}</h1>
        {author && <p class="author">Por {author.data.name}</p>}
        {post.data.spoilerLevel && post.data.spoilerLevel !== 'none' && <aside class="spoiler" role="note"><strong>Aviso de spoiler</strong><span>Este artigo contém spoilers classificados como {post.data.spoilerLevel}.</span></aside>}
        <div class="content">
          <Content/>
        </div>
        {post.data.sources.length > 0 && <section class="sources"><h2>Fontes</h2><ul>{post.data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ul></section>}
        {works.length > 0 && <section class="related-works"><h2>Obras relacionadas</h2><ul>{works.map((work) => <li><a href={basePath(`/obras/${work!.id}/`)}>{work!.data.title}</a></li>)}</ul></section>}

        <div class="share-section">
          <span>Compartilhar:</span>
          <div class="share-links">
            <a href={xShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn">X</a>
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="share-btn">LinkedIn</a>
            <button id="copy-link-btn" data-url={postUrl} class="share-btn">Copiar link</button>
          </div>
        </div>

        <nav class="post-nav">
          <div class="nav-prev">
            {prevPost && (
              <a href={basePath(`/posts/${prevPost.id}/`)} class="nav-link">
                ← {prevPost.data.title}
              </a>
            )}
          </div>
          <div class="nav-next">
            {nextPost && (
              <a href={basePath(`/posts/${nextPost.id}/`)} class="nav-link">
                {nextPost.data.title} →
              </a>
            )}
          </div>
        </nav>

        {relatedPosts.length > 0 && <section class="related-posts"><h2>Continue lendo</h2><div class="related-list">{relatedPosts.map((item) => <PostCard post={item} />)}</div></section>}

        <div class="comments-section" style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border);">
          {giscusConfigured ? <div id="giscus-container"></div> : <p class="comments-fallback">Comentários indisponíveis no momento. Você pode compartilhar este artigo pelos links acima.</p>}
        </div>

        {giscusConfigured && <script is:inline define:vars={{ giscusRepo, giscusRepoId, giscusCategory, giscusCategoryId }}>
          (function initGiscus() {
            const isDark = document.documentElement.classList.contains('dark') || localStorage.getItem('theme') === 'dark';
            const theme = isDark ? 'noborder_dark' : 'light';

            const script = document.createElement('script');
            script.src = 'https://giscus.app/client.js';
            script.setAttribute('data-repo', giscusRepo);
            script.setAttribute('data-repo-id', giscusRepoId);
            script.setAttribute('data-category', giscusCategory);
            script.setAttribute('data-category-id', giscusCategoryId);
            script.setAttribute('data-mapping', 'pathname');
            script.setAttribute('data-strict', '0');
            script.setAttribute('data-reactions-enabled', '1');
            script.setAttribute('data-emit-metadata', '0');
            script.setAttribute('data-input-position', 'bottom');
            script.setAttribute('data-theme', theme);
            script.setAttribute('data-lang', 'pt');
            script.setAttribute('crossorigin', 'anonymous');
            script.async = true;

            document.getElementById('giscus-container')?.appendChild(script);
          })();
        </script>}
      </article>
    </div>

    {/* Table of Contents Sidebar */}
    {headings && headings.length > 0 && (
      <aside class="sidebar">
        <div class="sidebar-content">
          <h2>Neste Artigo</h2>
          <ul class="toc-list">
            {headings.map((heading: { depth: number; slug: string; text: string }) => (
              <li style={`padding-left: ${(heading.depth - 2) * 1}rem`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </div>

  <script is:inline>
    window.addEventListener('scroll', () => {
      const progressBar = document.getElementById('progress-bar');
      if (!progressBar) return;
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      progressBar.style.width = scrolled + '%';
    });

    document.addEventListener("DOMContentLoaded", () => {
      // Process Copy Link button
      const copyLinkBtn = document.getElementById("copy-link-btn");
      if (copyLinkBtn) {
        copyLinkBtn.addEventListener("click", async () => {
          const url = copyLinkBtn.getAttribute("data-url") || window.location.href;
          try {
            await navigator.clipboard.writeText(url);
            const originalText = copyLinkBtn.innerText;
            copyLinkBtn.innerText = "Link copiado!";
            setTimeout(() => {
              copyLinkBtn.innerText = originalText;
            }, 2000);
          } catch (err) {
            console.error("Falha ao copiar link: ", err);
          }
        });
      }

      // Process GitHub-flavored alerts in blockquotes
      const blockquotes = document.querySelectorAll(".content blockquote");
      blockquotes.forEach((bq) => {
        const firstP = bq.querySelector("p");
        if (!firstP) return;
        const text = firstP.innerHTML;
        const match = text.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*(.*)/i);
        if (match) {
          const type = match[1].toLowerCase();
          bq.setAttribute("data-alert", type);
          const badgeText = match[1].toUpperCase();
          const restText = match[2];
          firstP.innerHTML = `<strong class="alert-title alert-title-${type}">${badgeText}</strong>${restText ? '<br/>' + restText : ''}`;
        }
      });

      // Process Copy button in pre code blocks
      const codeBlocks = document.querySelectorAll(".content pre");
      codeBlocks.forEach((pre) => {
        pre.style.position = "relative";
        
        const copyBtn = document.createElement("button");
        copyBtn.className = "copy-btn";
        copyBtn.innerText = "Copiar";
        
        copyBtn.addEventListener("click", async () => {
          const code = pre.querySelector("code");
          const text = code ? code.innerText : pre.innerText;
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.innerText = "Copiado!";
            setTimeout(() => {
              copyBtn.innerText = "Copiar";
            }, 2000);
          } catch (err) {
            console.error("Falha ao copiar texto: ", err);
          }
        });

        pre.appendChild(copyBtn);
      });
    });
  </script>
</Layout>

<style>
  #progress-bar { 
    position: fixed; 
    top: 0; 
    left: 0; 
    height: 3px; 
    background: var(--accent); 
    width: 0%; 
    z-index: 9999; 
    transition: width 0.1s ease-out; 
  }

  .layout-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 768px) { .layout-grid { grid-template-columns: 1fr 250px; align-items: start; } }
  .sidebar-content { position: sticky; top: 2rem; padding: 1.5rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); }
  .sidebar-content h3 { margin-top: 0; margin-bottom: 1.2rem; font-size: 1.1rem; color: var(--text); }
  .toc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .toc-list a { color: var(--muted); font-size: 0.9rem; text-decoration: none; transition: color 0.2s; display: block; line-height: 1.4; }
  .toc-list a:hover { color: var(--accent); }

  .back-link { display: inline-block; margin-bottom: 2.5rem; font-size: 0.95rem; color: var(--muted); }
  .breadcrumbs { margin:.4rem 0 1rem; color:var(--muted); font-size:.85rem; }
  .category-label { color:var(--accent); font-size:.8rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .article-figure { margin:1rem 0 2rem; }
  .article-cover { display:block; max-width:100%; max-height:28rem; object-fit:cover; border-radius:var(--radius); }
  .article-figure figcaption { margin-top:.5rem;color:var(--muted);font-size:.8rem; }
  .author { color:var(--muted); }
  .spoiler { display:grid; gap:.25rem; padding:1rem; margin:1.5rem 0; border-left:3px solid #eab308; background:var(--card-bg); border-radius:0 var(--radius) var(--radius) 0; }
  .spoiler strong { color:#a16207; }
  html.dark .spoiler strong { color:#facc15; }
  .related-works,.related-posts { margin-top:2rem; }
  .sources { margin-top:2rem; }
  .related-list { display:grid; gap:.8rem; }
  .back-link:hover { color: var(--accent); }
  .post-date { font-size: 0.95rem; color: var(--muted); display: block; margin-bottom: 0.8rem; }
  .updated-date { color: var(--muted); font-size: 0.85rem; margin-left: 0.5rem; font-style: italic; }

  .tags { display: flex; gap: 0.5rem; margin: 1rem 0 1.5rem 0; flex-wrap: wrap; }
  .tag { font-size: 0.85rem; color: var(--accent); background: var(--code-bg); padding: 0.2rem 0.6rem; border-radius: 4px; text-decoration: none; border: 1px solid transparent; transition: border-color 0.2s; }
  .tag:hover { border-color: var(--accent); }

  .post-title { margin: 0 0 2.5rem 0; font-size: 2.2rem; line-height: 1.3; color: var(--text); }
  .content :global(h2), .content :global(h3) { margin-top: 2.5rem; margin-bottom: 1rem; color: var(--text); }
  .content :global(p) { margin-bottom: 1.5rem; font-size: 1.05rem; }
  .content :global(ul), .content :global(ol) { margin-bottom: 1.5rem; font-size: 1.05rem; }
  
  .content :global(blockquote) { 
    border-left: 4px solid var(--border); 
    padding: 0.8rem 1.2rem; 
    background: var(--card-bg); 
    border-radius: 0 6px 6px 0; 
    margin: 1.5rem 0; 
    color: var(--text);
  }
  .content :global(blockquote[data-alert="note"]) { border-left-color: var(--accent); }
  .content :global(blockquote[data-alert="tip"]) { border-left-color: #10b981; }
  .content :global(blockquote[data-alert="important"]) { border-left-color: #8b5cf6; }
  .content :global(blockquote[data-alert="warning"]) { border-left-color: #eab308; }
  .content :global(blockquote[data-alert="caution"]) { border-left-color: #ef4444; }

  .content :global(.alert-title) { display: block; margin-bottom: 0.4rem; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; }
  .content :global(.alert-title-note) { color: var(--accent); }
  .content :global(.alert-title-tip) { color: #10b981; }
  .content :global(.alert-title-important) { color: #8b5cf6; }
  .content :global(.alert-title-warning) { color: #eab308; }
  .content :global(.alert-title-caution) { color: #ef4444; }

  .content :global(pre) { position: relative; }
  .content :global(.copy-btn) {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: var(--code-bg);
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .content :global(.copy-btn:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }

  .share-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .share-links {
    display: flex;
    gap: 0.6rem;
  }
  .share-btn {
    font-size: 0.85rem;
    color: var(--text);
    background: var(--card-bg);
    border: 1px solid var(--border);
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .share-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .nav-prev, .nav-next { flex: 1; }
  .nav-next { text-align: right; }
  .nav-link {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .comments-section {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
