---
import Layout from '../layouts/Layout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import { basePath, isPublicWork, postDate, publicPosts } from '../utils/content';
import { loadPosts, loadWorks } from '../utils/dev-fixtures';

const [allPosts, allWorks] = await Promise.all([loadPosts(), loadWorks()]);
const posts = publicPosts(allPosts);
// Editorial decision: keep the legacy Astro sample in a separate technical archive
// so it is never presented as an anime/manga publication while preserving its URL.
const archivePosts = posts.filter((post) => post.id === 'ola-mundo');
const editorialPosts = posts.filter((post) => !archivePosts.includes(post));
const featured = editorialPosts.find((post) => post.data.featured) ?? editorialPosts[0];
const latest = (featured ? editorialPosts.filter((post) => post.id !== featured.id) : editorialPosts).slice(0, 6);
const works = allWorks.filter(isPublicWork);
const animePosts = editorialPosts.filter((post) => post.data.type === 'anime' || post.data.type === 'review').slice(0, 3);
const mangaPosts = editorialPosts.filter((post) => post.data.type === 'manga' || post.data.type === 'guide').slice(0, 3);
const latestGridClass = latest.length === 1
  ? 'post-results--cols-1'
  : (latest.length === 2 || latest.length === 4)
    ? 'post-results--cols-2'
    : 'post-results--cols-3';
const workGridClass = works.length === 1
  ? 'work-grid--cols-1'
  : works.length === 2
    ? 'work-grid--cols-2'
    : works.length === 3
      ? 'work-grid--cols-3'
      : 'work-grid--cols-4';
const categories = [
  { title: 'Notícias', description: 'Atualizações e agenda da temporada.', href: basePath('/noticias/'), icon: 'news' as const },
  { title: 'Anime', description: 'Séries, filmes e direção de animação.', href: basePath('/animes/'), icon: 'anime' as const },
  { title: 'Mangá', description: 'Quadrinhos, edições e narrativa visual.', href: basePath('/mangas/'), icon: 'manga' as const },
  { title: 'Reviews', description: 'Críticas e análises aprofundadas.', href: basePath('/reviews/'), icon: 'review' as const },
  { title: 'Guias', description: 'Roteiros para escolher o que assistir ou ler.', href: basePath('/guias/'), icon: 'guide' as const },
  { title: 'Catálogo de obras', description: 'Fichas consultáveis por gênero e temporada.', href: basePath('/obras/'), icon: 'catalog' as const },
];
const months = posts.reduce((groups, post) => {
  const date = new Date(`${postDate(post)}T12:00:00Z`);
  const month = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
  (groups[month] ??= []).push(post);
  return groups;
}, {} as Record<string, typeof posts>);
---

<Layout title="Anime & Mangá" description="Notícias, artigos, reviews e guias sobre anime e mangá.">
  <header class="home-toolbar">
    <div class="home-intro">
      <h1>Anime &amp; Mangá</h1>
      <p>Notícias, análises, guias de leitura e catálogo editorial.</p>
    </div>
  </header>

  {editorialPosts.length > 0 ? (
    <section class="recent-section" aria-labelledby="recent-title">
      <SectionHeading id="recent-title" title="Publicações recentes" description="Destaques, notícias, análises e guias mais recentes." actionHref={basePath('/noticias/')} actionLabel="Ver notícias" />
      {featured && (
        <div class="featured-slot">
          <FeaturedPost post={featured} />
        </div>
      )}
      {latest.length > 0 && (
        <div id="post-results" class:list={['post-results', latestGridClass]}>
          {latest.map((post) => <PostCard post={post} />)}
        </div>
      )}
    </section>
  ) : (
    <div id="post-results" class="post-results" hidden></div>
  )}

  {(animePosts.length > 0 || mangaPosts.length > 0) && (
    <section class="thematic-split" aria-label="Destaques de Anime e Mangá">
      {animePosts.length > 0 && (
        <div class="thematic-column">
          <SectionHeading title="Anime & Reviews" actionHref={basePath('/animes/')} actionLabel="Ver animes" />
          <div class="thematic-list">
            {animePosts.map((post) => <PostCard post={post} variant="compact" showTags={false} />)}
          </div>
        </div>
      )}
      {mangaPosts.length > 0 && (
        <div class="thematic-column">
          <SectionHeading title="Mangá & Guias" actionHref={basePath('/mangas/')} actionLabel="Ver mangás" />
          <div class="thematic-list">
            {mangaPosts.map((post) => <PostCard post={post} variant="compact" showTags={false} />)}
          </div>
        </div>
      )}
    </section>
  )}

  {works.length > 0 && (
    <section class="catalog-section" aria-labelledby="works-title">
      <SectionHeading
        id="works-title"
        title="Catálogo de obras"
        description="Fichas editoriais de anime e mangá com gêneros, temporadas e artigos associados."
        actionHref={basePath('/obras/')}
        actionLabel="Ver catálogo completo"
      />
      <div class:list={['work-grid', workGridClass]}>
        {works.slice(0, 4).map((work) => <WorkCard work={work} />)}
      </div>
    </section>
  )}

  <section id="categorias" class="categories-section" aria-labelledby="categories-title">
    <SectionHeading
      id="categories-title"
      title="Navegar por categorias"
      description="Acesse diretamente cada editoria ou explore o índice de temporadas."
      actionHref={basePath('/temporadas/')}
      actionLabel="Ver temporadas de anime"
    />
    <nav class="category-grid" aria-label="Categorias do blog">
      {categories.map((category) => <CategoryCard {...category} />)}
    </nav>
  </section>

  {archivePosts.length > 0 && (
    <section class="archive-section" aria-labelledby="archive-title">
      <SectionHeading
        id="archive-title"
        title="Arquivo geral"
        description="Publicações técnicas legadas preservadas fora do feed temático de anime e mangá."
        actionHref={basePath('/arquivo/')}
        actionLabel="Abrir página do arquivo"
      />
      <div class="archive-grid">
        {archivePosts.map((post) => <PostCard post={post} variant="compact" />)}
      </div>
      {Object.keys(months).length > 1 && (
        <details class="archive-months">
          <summary>Ver índice cronológico por mês</summary>
          <div class="months-grid">
            {Object.entries(months).map(([month, monthPosts]) => (
              <section>
                <h3>{month}</h3>
                <ul>
                  {monthPosts.map((post) => <li><a href={basePath(`/posts/${post.id}/`)}>{post.data.title}</a></li>)}
                </ul>
              </section>
            ))}
          </div>
        </details>
      )}
    </section>
  )}
</Layout>

<style>
  .home-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .5rem 1.5rem;
    padding: 0 0 1.25rem;
    border-bottom: 1px solid var(--line-subtle);
  }
  .home-intro {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: .35rem 1rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    letter-spacing: -.035em;
  }
  .home-intro p {
    margin: 0;
    color: var(--muted);
    font-size: .95rem;
  }

  .recent-section,
  .thematic-split,
  .catalog-section,
  .categories-section,
  .archive-section {
    margin-top: 2.25rem;
  }

  .featured-slot {
    margin-bottom: 1.35rem;
  }

  .post-results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .post-results--cols-1 {
    grid-template-columns: minmax(0, 1fr);
  }
  .post-results--cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .thematic-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }
  .thematic-list {
    display: grid;
    gap: .9rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .work-grid--cols-1 { grid-template-columns: minmax(0, 22rem); }
  .work-grid--cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .work-grid--cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .9rem;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  .archive-months {
    margin-top: 1rem;
    padding: .75rem 1rem;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .archive-months summary {
    color: var(--ink);
    font-size: .85rem;
    font-weight: 650;
  }
  .months-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
    margin-top: .75rem;
  }
  .archive-months h3 { margin: 0; font-size: .88rem; }
  .archive-months ul { margin: .35rem 0 0; padding-left: 1.1rem; font-size: .82rem; }

  @media (max-width: 980px) {
    .post-results { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .thematic-split { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .home-toolbar { flex-direction: column; align-items: stretch; gap: .5rem; }
    .home-intro { flex-direction: column; gap: .2rem; }
    .post-results,
    .post-results--cols-2,
    .category-grid { grid-template-columns: 1fr; }
    .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  }
  @media (max-width: 380px) {
    .work-grid { grid-template-columns: 1fr; }
  }
</style>
