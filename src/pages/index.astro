---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { basePath, postDate, publicPosts } from '../utils/content';

const posts = publicPosts(await getCollection('posts'));
const taxonomies = (await getCollection('taxonomies')).filter((taxonomy) => taxonomy.data.type === 'tag');
const taxonomyTagIds = new Set(taxonomies.map((taxonomy) => taxonomy.id));
const tagLabels = new Map(taxonomies.map((taxonomy) => [taxonomy.id, taxonomy.data.name]));
const featured = posts.find((post) => post.data.featured);
const latest = (featured ? posts.filter((post) => post.id !== featured.id) : posts).slice(0, 6);
const tagCounts = posts.flatMap((post) => [...new Set([
  ...post.data.tags,
  ...post.data.taxonomyRefs.map((reference) => reference.id).filter((id) => taxonomyTagIds.has(id)),
])]).reduce((counts, tag) => {
  counts[tag] = (counts[tag] ?? 0) + 1;
  return counts;
}, {} as Record<string, number>);
const monthGroups = posts.reduce((groups, post) => {
  const date = new Date(`${postDate(post)}T12:00:00Z`);
  const label = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
  (groups[label] ??= []).push(post);
  return groups;
}, {} as Record<string, typeof posts>);
---

<Layout title="Anime & Mangá — artigos e recomendações" description="Notícias, análises, guias e descobertas de anime e mangá em português.">
  <section class="intro">
    <p class="eyebrow">ANIME · MANGÁ · CULTURA</p>
    <h1>Histórias que continuam<br />depois dos créditos.</h1>
    <p class="lead">Análises, guias e descobertas de anime e mangá, com contexto e sem pressa.</p>
    <a class="catalog-link" href={basePath('/obras/')}>Explorar catálogo de obras <span aria-hidden="true">→</span></a>
  </section>

  {featured && <section class="featured"><div><p class="eyebrow">EM DESTAQUE</p><h2><a href={basePath(`/posts/${featured.id}/`)}>{featured.data.title}</a></h2><p>{featured.data.description}</p><a class="read-link" href={basePath(`/posts/${featured.id}/`)}>Ler artigo →</a></div></section>}

  <div class="search-box"><label for="search-input">Buscar artigos</label><input type="search" id="search-input" placeholder="Título, resumo ou tag" /></div>

  <div class="content-grid">
    <div class="articles">
      <section class="listing" aria-labelledby="latest-title"><div class="section-heading"><p class="eyebrow">PUBLICAÇÕES</p><h2 id="latest-title">Últimos artigos</h2></div>
        {latest.length === 0 ? <EmptyState title="O blog está começando" message="Novas publicações aparecerão aqui quando forem adicionadas." /> : <div class="post-list">{latest.map((post) => <PostCard post={post} />)}</div>}
      </section>
      <section class="archives"><h2>Arquivo por mês</h2>{Object.entries(monthGroups).map(([month, monthPosts]) => <details><summary>{month} <span>({monthPosts.length})</span></summary><ul>{monthPosts.map((post) => <li><a href={basePath(`/posts/${post.id}/`)}>{post.data.title}</a></li>)}</ul></details>)}</section>
    </div>
    <aside class="sidebar"><section class="side-panel"><h2>Explore</h2><nav aria-label="Categorias"><a href={basePath('/noticias/')}>Notícias</a><a href={basePath('/animes/')}>Anime</a><a href={basePath('/mangas/')}>Mangá</a><a href={basePath('/reviews/')}>Reviews</a><a href={basePath('/guias/')}>Guias</a><a href={basePath('/temporadas/')}>Temporadas</a></nav></section>
      {Object.keys(tagCounts).length > 0 && <section class="side-panel"><h2>Tags</h2><div class="tag-cloud">{Object.entries(tagCounts).map(([tag, count]) => <a href={basePath(`/tags/${encodeURIComponent(tag)}/`)}>#{tagLabels.get(tag) ?? tag} <small>{count}</small></a>)}</div></section>}
    </aside>
  </div>

  <script>
    import '../scripts/home-search';
  </script>
</Layout>

<style>
  .intro { padding:2.5rem 0 3rem; border-bottom:1px solid var(--border); }
  .eyebrow { color:var(--accent); font-size:.75rem; font-weight:700; letter-spacing:.14em; }
  h1 { max-width:720px; margin:.7rem 0 1rem; font-size:clamp(2.25rem,7vw,4.6rem); letter-spacing:-.045em; line-height:1.03; }
  .lead { max-width:600px; color:var(--muted); font-size:1.1rem; }
  .catalog-link,.read-link { display:inline-block; margin-top:.6rem; font-weight:600; }
  .featured { margin:2rem 0; padding:2rem; border-left:3px solid var(--accent); background:var(--card-bg); border-radius:0 var(--radius) var(--radius) 0; }
  .featured h2 { margin:.4rem 0; font-size:clamp(1.5rem,4vw,2.2rem); }
  .featured h2 a { color:var(--text); }
  .featured p:not(.eyebrow) { color:var(--muted); }
  .search-box { margin:2rem 0; display:grid; gap:.5rem; }
  .search-box label { font-size:.9rem; font-weight:600; }
  .search-box input { width:100%; box-sizing:border-box; padding:.85rem 1rem; color:var(--text); background:var(--card-bg); border:1px solid var(--border); border-radius:var(--radius); font:inherit; }
  .content-grid { display:grid; grid-template-columns:minmax(0,1fr); gap:2rem; }
  .post-list { display:grid; gap:1rem; }
  .section-heading h2,.archives h2 { margin:0 0 1rem; font-size:1.5rem; }
  .section-heading .eyebrow { margin-bottom:.25rem; }
  .sidebar { display:grid; align-content:start; gap:1rem; }
  .side-panel { padding:1.25rem; border:1px solid var(--border); border-radius:var(--radius); background:var(--card-bg); }
  .side-panel h2 { margin:0 0 .8rem; font-size:1rem; }
  .side-panel nav { display:grid; gap:.55rem; }
  .tag-cloud { display:flex; flex-wrap:wrap; gap:.5rem; }
  .tag-cloud a { padding:.3rem .5rem; border-radius:6px; background:var(--code-bg); font-size:.85rem; }
  .tag-cloud small { color:var(--muted); }
  .archives { margin-top:3rem; }
  details { padding:.8rem 0; border-bottom:1px solid var(--border); }
  summary { cursor:pointer; font-weight:600; }
  summary span { color:var(--muted); font-weight:400; }
  details ul { margin:.6rem 0 0; padding-left:1.25rem; }
  @media (min-width:800px) { .content-grid { grid-template-columns:minmax(0,1fr) 240px; gap:2.5rem; } .sidebar { position:sticky; top:1rem; } }
</style>
