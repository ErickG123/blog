---
import Layout from '../../layouts/Layout.astro';
import PostListing from '../../components/PostListing.astro';
import { postsOfType } from '../../utils/content';
import { loadPosts } from '../../utils/dev-fixtures';

const posts = postsOfType(await loadPosts(), 'review');
---
<Layout title="Reviews de anime e mangá">
  <PostListing title="Reviews" description="Críticas e análises aprofundadas sobre obras de anime e mangá." posts={posts} />
</Layout>
