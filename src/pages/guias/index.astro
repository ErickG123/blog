---
import Layout from '../../layouts/Layout.astro';
import PostListing from '../../components/PostListing.astro';
import { postsOfType } from '../../utils/content';
import { loadPosts } from '../../utils/dev-fixtures';

const posts = postsOfType(await loadPosts(), 'guide');
---
<Layout title="Guias de anime e mangá">
  <PostListing title="Guias" description="Guias práticos para explorar histórias, universos, formatos e temporadas." posts={posts} />
</Layout>
