---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import EmptyState from '@shared/ui/EmptyState.astro';
import ListControls from '@shared/ui/ListControls.astro';
import { formatDatePtBr, ROUTES } from '@shared/domain/rules';
import { formatCountPtBr } from '@shared/utils/i18n';
import { PAGINATION_LIMITS } from '@shared/config/pagination';
import { getPublicRecommendations } from '@features/content/content.selectors';

const guides = await getPublicRecommendations();
---

<BaseLayout
  title="Guias e recomendações"
  description="Listas curadas e guias de leitura conectados à biblioteca de obras."
>
  <section class="ma-hero">
    <h1>Guias e recomendações</h1>
    <p>Listas ordenadas e curadoria editorial para descobrir novas leituras com contexto.</p>
  </section>

  {guides.length > 0 ? (
    <>
      <ListControls
        containerSelector="[data-guides-list]"
        itemSelector="[data-list-item]"
        pageSize={PAGINATION_LIMITS.guides}
        nounPlural="guias"
      />
      <ul class="ma-entry-list" data-guides-list>
        {guides.map((guide) => (
          <li
            class="ma-entry"
            data-list-item
            data-sort-title={guide.title}
            data-sort-date={String(Date.parse(guide.publishedAt))}
          >
            <div class="ma-entry__meta">
              <time datetime={guide.publishedAt}>{formatDatePtBr(guide.publishedAt)}</time>
              <span>{formatCountPtBr(guide.items.length, 'obra', 'obras')}</span>
            </div>
            <h2 class="ma-entry__title">
              <a href={ROUTES.guide(guide.slug)}>{guide.title}</a>
            </h2>
            <p class="ma-entry__summary">{guide.summary}</p>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <EmptyState
      title="Nenhum guia publicado ainda"
      description="Guias de entrada e listas de recomendações aparecerão aqui."
    />
  )}
</BaseLayout>
