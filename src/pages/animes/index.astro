---
import Layout from '../../layouts/Layout.astro'; import PostListing from '../../components/PostListing.astro'; import { getCollection } from 'astro:content'; import { postsOfType } from '../../utils/content';
const posts = postsOfType(await getCollection('posts'), 'anime');
---
<Layout title="Artigos sobre anime"><PostListing title="Anime" description="Artigos e análises sobre anime." posts={posts} /></Layout>
