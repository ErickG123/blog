---
import { render } from 'astro:content';
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import MediaFigure from '@shared/ui/MediaFigure.astro';
import { formatDatePtBr, ROUTES } from '@shared/domain/rules';
import {
  getPublicCollectingPosts,
  getPublicEditions,
  getPublicPublishers,
  getPublicWorks,
} from '@features/content/content.selectors';

export async function getStaticPaths() {
  const posts = await getPublicCollectingPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post.entry);
const [editions, works, publishers] = await Promise.all([
  getPublicEditions(),
  getPublicWorks(),
  getPublicPublishers(),
]);
const publisherMap = new Map(publishers.map((p) => [p.id, p]));
const postEditions = editions.filter((e) => post.editionIds.includes(e.id));
const postWorks = works.filter((w) => post.workIds.includes(w.id));
---

<BaseLayout title={post.title} description={post.summary} ogType="article">
  <article data-pagefind-body>
    <header class="ma-hero">
      <h1>{post.title}</h1>
      <p>{post.summary}</p>
      <p style="font-size: var(--ma-text-sm); margin-top: 0.75rem;">
        Publicado em <time datetime={post.publishedAt}>{formatDatePtBr(post.publishedAt)}</time>
      </p>
    </header>

    {post.cover && <MediaFigure asset={post.cover} eager />}

    {postEditions.length > 0 && (
      <section aria-label="Comparativo de edições físicas">
        <h2>Ficha comparativa de edições</h2>
        <div class="ma-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Edição</th>
                <th scope="col">Editora</th>
                <th scope="col">Formato</th>
                <th scope="col">Papel</th>
                <th scope="col">Acabamento</th>
                <th scope="col">Ano</th>
              </tr>
            </thead>
            <tbody>
              {postEditions.map((ed) => {
                const pub = publisherMap.get(ed.publisherId);
                return (
                  <tr>
                    <td>
                      <strong>{ed.title}</strong>
                    </td>
                    <td>
                      {pub ? <a href={ROUTES.publisher(pub.slug)}>{pub.name}</a> : ed.publisherId}
                    </td>
                    <td>{ed.formatLabel ?? 'Não informado'}</td>
                    <td>{ed.paperType ?? 'Não informado'}</td>
                    <td>{ed.binding ?? 'Não informado'}</td>
                    <td>{ed.releaseYear ?? '—'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <div class="ma-prose">
      <Content />
    </div>

    {postWorks.length > 0 && (
      <section style="margin-top: 2rem;">
        <h2>Obras relacionadas</h2>
        <ul>
          {postWorks.map((w) => (
            <li>
              <a href={ROUTES.work(w.slug)}>{w.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
