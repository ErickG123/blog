---
import Layout from '../../layouts/Layout.astro';
import PostListing from '../../components/PostListing.astro';
import { postDate, publicPosts } from '../../utils/content';
import { loadPosts, loadTaxonomies } from '../../utils/dev-fixtures';

export async function getStaticPaths() {
  const posts = publicPosts(await loadPosts());
  const taxonomies = (await loadTaxonomies()).filter((taxonomy) => taxonomy.data.type === 'tag');
  const taxonomyTagIds = new Set(taxonomies.map((taxonomy) => taxonomy.id));
  const tags = [...new Set([
    ...posts.flatMap((post) => post.data.tags),
    ...posts.flatMap((post) => post.data.taxonomyRefs.map((reference) => reference.id).filter((id) => taxonomyTagIds.has(id))),
    ...taxonomies.map((taxonomy) => taxonomy.id),
  ])];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      label: taxonomies.find((taxonomy) => taxonomy.id === tag)?.data.name ?? tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag) || (taxonomyTagIds.has(tag) && post.data.taxonomyRefs.some((reference) => reference.id === tag)))
        .sort((a, b) => new Date(postDate(b)).getTime() - new Date(postDate(a)).getTime() || a.id.localeCompare(b.id)),
    },
  }));
}

const { tag, label, posts } = Astro.props;
---

<Layout title={`Artigos com a tag #${label}`}>
  <PostListing title={`#${label}`} description={`Publicações indexadas sob a tag ${label}.`} posts={posts} activeTag={tag} />
</Layout>
