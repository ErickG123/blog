---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { basePath, formatDate, postDate, publicPosts, readingTime } from '../../utils/content';

export async function getStaticPaths() {
  const posts = publicPosts(await getCollection('posts'));
  const taxonomies = (await getCollection('taxonomies')).filter((taxonomy) => taxonomy.data.type === 'tag');
  const taxonomyTagIds = new Set(taxonomies.map((taxonomy) => taxonomy.id));
  const uniqueTags = [...new Set([
    ...posts.flatMap((post) => post.data.tags),
    ...posts.flatMap((post) => post.data.taxonomyRefs.map((reference) => reference.id).filter((id) => taxonomyTagIds.has(id))),
    ...taxonomies.map((taxonomy) => taxonomy.id),
  ])];

  return uniqueTags.map((tag) => {
    const filteredPosts = posts
      .filter((post) => post.data.tags.includes(tag) || (taxonomyTagIds.has(tag) && post.data.taxonomyRefs.some((reference) => reference.id === tag)))
      .sort((a, b) => new Date(postDate(b)).getTime() - new Date(postDate(a)).getTime() || a.id.localeCompare(b.id));
    return {
      params: { tag },
      props: { posts: filteredPosts, label: taxonomies.find((taxonomy) => taxonomy.id === tag)?.data.name ?? tag },
    };
  });
}

const { tag } = Astro.params;
const { posts, label } = Astro.props;
const taxonomyTags = (await getCollection('taxonomies')).filter((taxonomy) => taxonomy.data.type === 'tag');

---

<Layout title={`Artigos com a tag #${tag}`}>
  <div class="tag-header">
    <a href={`${import.meta.env.BASE_URL}/`} class="back-link">← Voltar para o feed</a>
    <h1 class="tag-title">Tag: <span class="accent">#{label}</span></h1>
    <p class="tag-count">{posts.length} {posts.length === 1 ? 'artigo encontrado' : 'artigos encontrados'}</p>
  </div>

  <ul class="post-list">
    {posts.map((post) => {
      const minutes = readingTime(post.body);
      const postTags = [
        ...post.data.tags.map((id) => ({ id, label: id })),
        ...post.data.taxonomyRefs
          .map((reference) => taxonomyTags.find((taxonomy) => taxonomy.id === reference.id))
          .filter((taxonomy) => taxonomy !== undefined)
          .map((taxonomy) => ({ id: taxonomy.id, label: taxonomy.data.name })),
      ];
      return (
        <li class="post-card">
          <div class="post-date">{formatDate(postDate(post))} · {minutes} min de leitura</div>
          <a href={basePath(`/posts/${post.id}/`)} class="post-title">
            {post.data.title}
          </a>
          <p class="post-desc">{post.data.description}</p>
          {postTags.length > 0 && (
            <div class="tags">
              {postTags.map(({ id, label }) => (
                <a href={basePath(`/tags/${encodeURIComponent(id)}/`)} class={`tag ${id === tag ? 'active' : ''}`}>
                  #{label}
                </a>
              ))}
            </div>
          )}
        </li>
      );
    })}
  </ul>
</Layout>

<style>
  .tag-header { margin-bottom: 2.5rem; }
  .back-link { display: inline-block; margin-bottom: 1.5rem; font-size: 0.95rem; color: var(--muted); }
  .back-link:hover { color: var(--accent); }
  .tag-title { font-size: 2rem; margin: 0 0 0.5rem 0; color: var(--text); }
  .tag-title .accent { color: var(--accent); }
  .tag-count { margin: 0; color: var(--muted); font-size: 0.95rem; }
  
  .post-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .post-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .post-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .post-date { font-size: 0.85rem; color: var(--muted); margin-bottom: 0.5rem; }
  .post-title { font-size: 1.25rem; font-weight: 600; display: block; margin-bottom: 0.5rem; text-decoration: none; }
  .post-title:hover { text-decoration: none; opacity: 0.8; }
  .post-desc { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.6; }
  
  .tags { display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap; }
  .tag { font-size: 0.85rem; color: var(--accent); background: var(--code-bg); padding: 0.2rem 0.6rem; border-radius: 4px; text-decoration: none; transition: opacity 0.2s; }
  .tag:hover { opacity: 0.8; text-decoration: none; }
  .tag.active {
    background: var(--accent);
    color: var(--accent-contrast);
  }
</style>
