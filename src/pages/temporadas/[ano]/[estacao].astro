---
import Layout from '../../../layouts/Layout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import WorkCard from '../../../components/WorkCard.astro';
import { basePath, isPublicWork, seasonLabels } from '../../../utils/content';
import { loadWorks } from '../../../utils/dev-fixtures';
type Season = keyof typeof seasonLabels;

export async function getStaticPaths() {
  const works = (await loadWorks()).filter(isPublicWork);
  const groups = [...new Set(works.filter((work) => work.data.mediaType === 'anime' && work.data.releaseYear && work.data.season).map((work) => `${work.data.releaseYear}/${work.data.season}`))];
  return groups.map((group) => {
    const [ano, estacao] = group.split('/');
    return { params: { ano, estacao } };
  });
}

const { ano, estacao } = Astro.params;
const season = estacao as Season;
const works = (await loadWorks()).filter((work) => isPublicWork(work) && work.data.mediaType === 'anime' && String(work.data.releaseYear) === ano && work.data.season === season);
---

<Layout title={`Anime — ${seasonLabels[season]} ${ano}`} description={`Obras de anime cadastradas para ${seasonLabels[season]} de ${ano}.`}>
  <div class="season-detail">
    <header class="page-heading">
      <a class="back-link" href={basePath('/temporadas/')}>← Todas as temporadas</a>
      <h1>{seasonLabels[season]} {ano}</h1>
      <p>{works.length} {works.length === 1 ? 'obra cadastrada nesta temporada' : 'obras cadastradas nesta temporada'}.</p>
    </header>
    {works.length > 0 ? (
      <div class="work-grid">
        {works.map((work) => <WorkCard work={work} />)}
      </div>
    ) : (
      <EmptyState
        title="Temporada sem obras"
        message="Não há obras cadastradas para esta temporada."
        actionHref={basePath('/temporadas/')}
        actionLabel="Voltar às temporadas"
      />
    )}
  </div>
</Layout>

<style>
  .season-detail { display: grid; gap: 1.5rem; }
  .back-link {
    width: max-content;
    color: var(--muted);
    font-size: .82rem;
    font-weight: 650;
    text-decoration: none;
  }
  .back-link:hover { color: var(--accent); }
  .page-heading {
    display: grid;
    gap: .35rem;
    padding: 0 0 1.25rem;
    border-bottom: 1px solid var(--line-subtle);
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -.03em;
  }
  .page-heading > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: .95rem;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 850px) { .work-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; } }
  @media (max-width: 360px) { .work-grid { grid-template-columns: 1fr; } }
</style>
