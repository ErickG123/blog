---
import type { ImageAsset } from '@features/catalog/domain/catalog.model';

interface Props {
  asset: ImageAsset;
  caption?: string;
  eager?: boolean;
}

const { asset, caption, eager = false } = Astro.props;
---

<figure class="ma-figure">
  <img
    src={asset.src}
    alt={asset.alt}
    width={asset.width}
    height={asset.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  <figcaption>
    {caption ? `${caption} — ` : ''}Crédito: {asset.credit}
    {asset.license ? ` (${asset.license})` : ''}
  </figcaption>
</figure>
