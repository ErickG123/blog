---
import '@shared/styles/base.scss';
import '@shared/styles/components.scss';
import '@shared/styles/layout.scss';
import '@shared/styles/editorial.scss';
import { Search } from '@lucide/astro';
import ThemeToggle from '@shared/ui/ThemeToggle.astro';
import { PROJECT_IDENTITY } from '@shared/utils/project';
import { ROUTES } from '@shared/domain/rules';
import { shouldIncludeFixtures } from '@features/content/content.selectors';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = PROJECT_IDENTITY.tagline,
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const isDemo = shouldIncludeFixtures();
const fullTitle = title ? `${title} — ${PROJECT_IDENTITY.name}` : PROJECT_IDENTITY.name;
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = siteOrigin ? `${siteOrigin}${canonicalPath}` : canonicalPath;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Reviews', href: ROUTES.reviews },
  { label: 'Artigos', href: ROUTES.articles },
  { label: 'Guias', href: ROUTES.guides },
  { label: 'Colecionismo', href: ROUTES.collecting },
  { label: 'Biblioteca', href: ROUTES.works },
];

const structuredData = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: PROJECT_IDENTITY.name,
  description: PROJECT_IDENTITY.tagline,
  inLanguage: 'pt-BR',
  url: canonicalUrl,
};
---

<!doctype html>
<html lang={PROJECT_IDENTITY.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {isDemo && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <link rel="alternate" type="application/rss+xml" title="Mangá Atlas RSS" href="/rss.xml" />
    <title>{fullTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (() => {
        try {
          const stored = window.localStorage.getItem('ma-theme');
          const prefersDark =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const resolved =
            stored === 'dark' || stored === 'light' ? stored : prefersDark ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', resolved);
        } catch {
          // fallback seguro sem localStorage
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo principal
    </a>
    {isDemo && (
      <div class="ma-demo-banner" role="note">
        <div class="ma-container">
          <strong>Modo demonstração</strong> — exibindo conteúdo demonstrativo isolado do build
          editorial real (<code>noindex</code>).
        </div>
      </div>
    )}
    <header class="ma-header">
      <div class="ma-container ma-header__inner">
        <a class="ma-brand" href={ROUTES.home} aria-label="Mangá Atlas — Página inicial">
          <span>Mangá</span>
          <span class="ma-brand__accent">Atlas</span>
        </a>
        <nav class="ma-nav" aria-label="Navegação principal">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={
                currentPath === item.href || currentPath.startsWith(item.href) ? 'page' : undefined
              }
            >
              {item.label}
            </a>
          ))}
          <a
            href={ROUTES.search}
            aria-label="Pesquisar no Mangá Atlas"
            aria-current={currentPath.startsWith(ROUTES.search) ? 'page' : undefined}
            style="display: inline-flex; align-items: center; gap: 0.3rem;"
          >
            <Search size={15} aria-hidden="true" />
            <span>Busca</span>
          </a>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="conteudo" class="ma-main">
      <div class="ma-container">
        <slot />
      </div>
    </main>

    <footer class="ma-footer">
      <div class="ma-container">
        <div class="ma-footer__grid">
          <div class="ma-footer__col">
            <a class="ma-brand" href={ROUTES.home} style="margin-bottom: 0.5rem;">
              <span>Mangá</span>
              <span class="ma-brand__accent">Atlas</span>
            </a>
            <p style="margin: 0; max-width: 28ch;">{PROJECT_IDENTITY.tagline}</p>
          </div>
          <div class="ma-footer__col">
            <h2>Editorial</h2>
            <ul>
              <li>
                <a href={ROUTES.reviews}>Reviews</a>
              </li>
              <li>
                <a href={ROUTES.articles}>Artigos e análises</a>
              </li>
              <li>
                <a href={ROUTES.guides}>Guias e recomendações</a>
              </li>
              <li>
                <a href={ROUTES.collecting}>Colecionismo</a>
              </li>
            </ul>
          </div>
          <div class="ma-footer__col">
            <h2>Catálogo</h2>
            <ul>
              <li>
                <a href={ROUTES.works}>Biblioteca de obras</a>
              </li>
              <li>
                <a href={ROUTES.tags}>Tags e temas</a>
              </li>
              <li>
                <a href={ROUTES.search}>Pesquisa global</a>
              </li>
            </ul>
          </div>
          <div class="ma-footer__col">
            <h2>Institucional</h2>
            <ul>
              <li>
                <a href={ROUTES.about}>Sobre</a>
              </li>
              <li>
                <a href={ROUTES.editorialPolicy}>Política Editorial</a>
              </li>
              <li>
                <a href={ROUTES.contact}>Contato</a>
              </li>
              <li>
                <a href="/rss.xml">Feed RSS</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="ma-footer__bottom">
          <span>
            © {new Date().getFullYear()} {PROJECT_IDENTITY.name}. Projeto editorial independente.
          </span>
          <span>Idioma: pt-BR · Saída estática</span>
        </div>
      </div>
    </footer>
  </body>
</html>
