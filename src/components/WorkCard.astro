---
import type { CollectionEntry } from 'astro:content';
import { basePath, seasonLabels } from '../utils/content';

interface Props { work: CollectionEntry<'works'>; }
const { work } = Astro.props;
const season = work.data.season ? seasonLabels[work.data.season] : undefined;
const metadata = [work.data.releaseYear, season].filter(Boolean).join(' · ');
const coverSrc = work.data.cover
  ? (work.data.cover.startsWith('data:') || work.data.cover.startsWith('http') ? work.data.cover : basePath(work.data.cover))
  : undefined;
---

<article class="work-card" data-work-id={work.id}>
  <a class="work-link" href={basePath(`/obras/${work.id}/`)}>
    <div class="poster">
      {coverSrc
        ? <img src={coverSrc} alt={work.data.coverAlt || `Capa de ${work.data.title}`} loading="eager" />
        : <span class="poster-fallback">Sem capa</span>}
      <span class="media-type">{work.data.mediaType === 'anime' ? 'Anime' : 'Mangá'}</span>
    </div>
    <div class="work-copy">
      {metadata && <p class="meta">{metadata}</p>}
      <h2>{work.data.title}</h2>
      <p class="synopsis">{work.data.synopsis}</p>
      {work.data.genres.length > 0 && <span class="genre-list">{work.data.genres.join(' · ')}</span>}
    </div>
  </a>
  {work.data.coverCredit && <small class="credit">Imagem: <a href={work.data.coverSource} target="_blank" rel="noopener noreferrer">{work.data.coverCredit}</a></small>}
</article>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
    transition: border-color .18s ease, box-shadow .18s ease;
  }
  .work-card:hover {
    border-color: var(--line);
    box-shadow: var(--shadow-sm);
  }
  .work-link {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    color: var(--ink);
    text-decoration: none;
  }
  .poster {
    position: relative;
    display: grid;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    place-items: center;
    background: var(--surface-soft);
    border-bottom: 1px solid var(--line-subtle);
  }
  .poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .25s ease;
  }
  .poster-fallback {
    padding: .5rem;
    text-align: center;
    color: var(--muted);
    font-size: .78rem;
    font-weight: 600;
  }
  .media-type {
    position: absolute;
    right: .55rem;
    bottom: .55rem;
    padding: .2rem .48rem;
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    font-size: .68rem;
    font-weight: 750;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .work-link:hover .poster img { transform: scale(1.02); }
  .work-copy {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: .35rem;
    padding: .9rem 1rem;
  }
  .meta {
    margin: 0;
    color: var(--muted);
    font-size: .73rem;
    font-weight: 700;
  }
  h2 {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.3;
  }
  .work-link:hover h2 { color: var(--accent); }
  .synopsis {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    font-size: .83rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .genre-list {
    margin-top: auto;
    padding-top: .25rem;
    color: var(--blue);
    font-size: .73rem;
    font-weight: 700;
  }
  .credit {
    display: block;
    padding: 0 1rem .75rem;
    color: var(--muted);
    font-size: .7rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .poster img { transition: none; }
  }
</style>
