---
import type { BlogPost } from '../utils/content';
import { basePath, formatDate, postDate, readingTime, typeLabels } from '../utils/content';

interface Props { post: BlogPost; }
const { post } = Astro.props;
const date = postDate(post);
const coverSrc = post.data.cover
  ? (post.data.cover.startsWith('data:') || post.data.cover.startsWith('http') ? post.data.cover : basePath(post.data.cover))
  : undefined;
---

<article class:list={['featured-post', { 'has-cover': Boolean(coverSrc) }]}>
  {coverSrc && (
    <a class="featured-image" href={basePath(`/posts/${post.id}/`)} tabindex="-1" aria-hidden="true">
      <img src={coverSrc} alt="" fetchpriority="high" />
    </a>
  )}
  <div class="featured-copy">
    <p class="meta">
      <span class="badge">{typeLabels[post.data.type]}</span>
      {post.data.rating !== undefined && <span class="rating">★ {post.data.rating.toFixed(1)}</span>}
      <time datetime={`${date}T12:00:00Z`}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min de leitura</span>
    </p>
    <h2><a href={basePath(`/posts/${post.id}/`)}>{post.data.title}</a></h2>
    <p class="summary">{post.data.description}</p>
    <div class="featured-footer">
      <a class="read-link" href={basePath(`/posts/${post.id}/`)}>Ler publicação <span aria-hidden="true">→</span></a>
      {post.data.coverCredit && <small class="credit">Imagem: <a href={post.data.coverSource} target="_blank" rel="noopener noreferrer">{post.data.coverCredit}</a></small>}
    </div>
  </div>
</article>

<style>
  .featured-post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .featured-post.has-cover {
    grid-template-columns: minmax(18rem, 1.15fr) minmax(0, 1fr);
  }
  .featured-post[hidden] { display: none !important; }
  .featured-image {
    display: block;
    overflow: hidden;
    background: var(--surface-soft);
    height: 100%;
  }
  .featured-image img {
    width: 100%;
    height: 100%;
    min-height: 16rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .featured-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .65rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .4rem .6rem;
    margin: 0;
    color: var(--muted);
    font-size: .78rem;
  }
  .badge {
    padding: .18rem .55rem;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .rating {
    padding: .15rem .45rem;
    border-radius: 4px;
    background: var(--surface-soft);
    color: var(--ink);
    font-weight: 750;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 1.95rem);
    line-height: 1.22;
    letter-spacing: -.03em;
  }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--accent); }
  .summary {
    margin: 0;
    color: var(--muted);
    font-size: .96rem;
    line-height: 1.6;
  }
  .featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .5rem 1rem;
    margin-top: .35rem;
  }
  .read-link {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .88rem;
    font-weight: 750;
    text-decoration: none;
  }
  .credit { color: var(--muted); font-size: .72rem; }
  @media (max-width: 820px) {
    .featured-post.has-cover { grid-template-columns: 1fr; }
    .featured-image img { min-height: 12rem; }
  }
</style>
