---
import { basePath, isPublicWork, publicPosts, typeLabels } from '../utils/content';
import { loadPosts, loadTaxonomies, loadWorks } from '../utils/dev-fixtures';
import type { SearchableItem } from '../utils/work-filters';

const [rawPosts, rawWorks, taxonomies] = await Promise.all([loadPosts(), loadWorks(), loadTaxonomies()]);
const posts = publicPosts(rawPosts);
const works = rawWorks.filter(isPublicWork);
const workTitlesById = new Map(works.map((work) => [work.id, work.data.title]));
const taxonomyNamesById = new Map(taxonomies.map((tax) => [tax.id, tax.data.name]));

const searchItems: SearchableItem[] = [
  ...posts.map((post) => ({
    id: `post:${post.id}`,
    kind: 'post' as const,
    categoryLabel: typeLabels[post.data.type],
    title: post.data.title,
    description: post.data.description,
    href: basePath(`/posts/${post.id}/`),
    tags: [
      ...post.data.tags,
      ...post.data.taxonomyRefs.map((ref) => taxonomyNamesById.get(ref.id) ?? ref.id),
    ],
    works: post.data.works.map((ref) => workTitlesById.get(ref.id) ?? ref.id),
  })),
  ...works.map((work) => ({
    id: `work:${work.id}`,
    kind: 'work' as const,
    categoryLabel: work.data.mediaType === 'anime' ? 'Obra · Anime' : 'Obra · Mangá',
    title: work.data.title,
    description: work.data.synopsis,
    href: basePath(`/obras/${work.id}/`),
    tags: [
      ...work.data.genres,
      ...work.data.genreRefs.map((ref) => taxonomyNamesById.get(ref.id) ?? ref.id),
      ...(work.data.originalTitle ? [work.data.originalTitle] : []),
    ],
  })),
];
---

<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-dialog-title">
  <div class="search-dialog-panel">
    <header class="search-dialog-header">
      <h2 id="search-dialog-title" class="search-dialog-title">Pesquisar no site</h2>
      <button id="search-dialog-close" class="search-dialog-close" type="button" aria-label="Fechar pesquisa">
        <span>Esc</span>
      </button>
    </header>

    <form id="search-dialog-form" class="search-dialog-form" role="search">
      <label for="global-search" class="sr-only">Buscar artigos, tags ou obras</label>
      <div class="search-field-wrap">
        <svg class="search-field-icon" aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="10.8" cy="10.8" r="6.8"></circle>
          <path d="m16 16 5 5"></path>
        </svg>
        <input
          id="global-search"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Buscar por título, descrição, tag ou obra..."
          aria-label="Buscar no blog"
        />
      </div>
    </form>

    <div class="search-dialog-body">
      <p id="search-dialog-status" class="search-dialog-status" role="status" aria-live="polite">
        {searchItems.length} {searchItems.length === 1 ? 'item disponível' : 'itens disponíveis'}
      </p>

      <ul id="search-dialog-results" class="search-results-list" aria-label="Resultados da pesquisa">
        {searchItems.map((item) => (
          <li class="search-result-item" data-search-id={item.id}>
            <a class="search-result-link" href={item.href}>
              <div class="result-meta">
                <span class="result-badge">{item.categoryLabel}</span>
                {item.tags.length > 0 && (
                  <span class="result-tags">
                    {item.tags.slice(0, 3).map((tag) => `#${tag}`).join(' · ')}
                  </span>
                )}
              </div>
              <strong class="result-title">{item.title}</strong>
              <span class="result-description">{item.description}</span>
            </a>
          </li>
        ))}
      </ul>

      <div id="search-dialog-empty" class="search-empty-state" hidden>
        <strong>Nenhum resultado encontrado</strong>
        <p>Nenhum texto corresponde à busca. Tente outras palavras, categorias ou tags.</p>
      </div>
    </div>
  </div>
  <script id="search-index-data" type="application/json" set:html={JSON.stringify(searchItems).replace(/</g, '\\u003c')} />
</dialog>

<style>
  .search-dialog {
    position: fixed;
    inset: 0;
    z-index: 120;
    width: min(560px, calc(100vw - 2rem));
    max-width: 560px;
    max-height: min(80vh, 38rem);
    margin: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .search-dialog:not([open]) {
    display: none;
  }
  .search-dialog::backdrop {
    background: rgb(15 20 26 / 52%);
    backdrop-filter: blur(2px);
  }
  .search-dialog-panel {
    display: flex;
    flex-direction: column;
    max-height: min(80vh, 38rem);
  }
  .search-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .85rem 1.15rem;
    border-bottom: 1px solid var(--line-subtle);
  }
  .search-dialog-title {
    margin: 0;
    color: var(--muted);
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .search-dialog-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.85rem;
    padding: 0 .55rem;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-soft);
    color: var(--muted);
    font-size: .75rem;
    font-weight: 700;
    line-height: 1;
  }
  .search-dialog-close:hover {
    border-color: var(--line);
    color: var(--ink);
  }
  .search-dialog-form {
    padding: .9rem 1.15rem;
    border-bottom: 1px solid var(--line-subtle);
    background: var(--paper);
  }
  .search-field-wrap {
    display: flex;
    align-items: center;
    gap: .6rem;
    min-height: 2.75rem;
    padding: 0 .85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .search-field-wrap:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .search-field-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: var(--muted);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
  .search-field-wrap input {
    width: 100%;
    min-width: 0;
    padding: .5rem 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font-size: .95rem;
  }
  .search-dialog-body {
    overflow-y: auto;
    padding: .85rem 1.15rem 1.15rem;
  }
  .search-dialog-status {
    margin: 0 0 .65rem;
    color: var(--muted);
    font-size: .78rem;
    font-weight: 600;
  }
  .search-results-list {
    display: grid;
    gap: .55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .search-results-list[hidden],
  .search-result-item[hidden],
  .search-empty-state[hidden] {
    display: none !important;
  }
  .search-result-link {
    display: grid;
    gap: .25rem;
    padding: .75rem .9rem;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .search-result-link:hover,
  .search-result-link:focus-visible {
    border-color: var(--accent);
    background: var(--surface);
  }
  .result-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .4rem .6rem;
    font-size: .72rem;
  }
  .result-badge {
    padding: .12rem .42rem;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 800;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .result-tags {
    color: var(--blue);
    font-weight: 600;
  }
  .result-title {
    font-size: .95rem;
    line-height: 1.3;
    color: var(--ink);
  }
  .search-result-link:hover .result-title {
    color: var(--accent);
  }
  .result-description {
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .search-empty-state {
    padding: 1.5rem 1rem;
    text-align: center;
    border: 1px dashed var(--line-subtle);
    border-radius: var(--radius-md);
    background: var(--paper);
  }
  .search-empty-state strong {
    display: block;
    margin-bottom: .3rem;
    font-size: .95rem;
    color: var(--ink);
  }
  .search-empty-state p {
    margin: 0;
    color: var(--muted);
    font-size: .85rem;
  }
  @media (max-width: 520px) {
    .search-dialog {
      width: calc(100vw - 1.25rem);
      max-height: 85vh;
    }
    .search-dialog-header,
    .search-dialog-form,
    .search-dialog-body {
      padding-inline: .9rem;
    }
  }
</style>
