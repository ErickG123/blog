---
import type { BlogPost } from '../utils/content';
import PostCard from './PostCard.astro';
import EmptyState from './EmptyState.astro';
import { basePath } from '../utils/content';

interface Props {
  title: string;
  description: string;
  posts: BlogPost[];
  activeTag?: string;
}
const { title, description, posts, activeTag } = Astro.props;
const gridClass = posts.length === 1 ? 'post-list--cols-1' : 'post-list--cols-2';
---

<section class="collection-page">
  <header class="collection-heading">
    <div class="heading-top">
      <a class="back-link" href={basePath('/')}>← Início</a>
      <span class="collection-count">{posts.length} {posts.length === 1 ? 'publicação' : 'publicações'}</span>
    </div>
    <h1>{title}</h1>
    <p class="description">{description}</p>
  </header>

  {posts.length > 0 ? (
    <div class:list={['post-list', gridClass]}>
      {posts.map((post) => <PostCard post={post} activeTag={activeTag} />)}
    </div>
  ) : (
    <EmptyState
      title="Nenhuma publicação por enquanto"
      message={activeTag ? 'Ainda não há artigos publicados com esta tag.' : 'Novas publicações desta categoria aparecerão aqui assim que forem revisadas e publicadas.'}
      actionHref={basePath('/')}
      actionLabel="Voltar para a Home"
    />
  )}
</section>

<style>
  .collection-page {
    display: grid;
    gap: 1.5rem;
  }
  .collection-heading {
    display: grid;
    gap: .4rem;
    padding: 0 0 1.25rem;
    border-bottom: 1px solid var(--line-subtle);
  }
  .heading-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .25rem;
  }
  .back-link {
    color: var(--muted);
    font-size: .82rem;
    font-weight: 650;
    text-decoration: none;
  }
  .back-link:hover { color: var(--accent); }
  .collection-count {
    padding: .18rem .55rem;
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--muted);
    font-size: .76rem;
    font-weight: 700;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -.03em;
  }
  .description {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-size: .96rem;
  }
  .post-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .post-list--cols-1 {
    grid-template-columns: minmax(0, 44rem);
  }
  @media (max-width: 720px) {
    .post-list {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
